{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Quartz.Core.QuartzSchedulerThread": "Warning"
    }
  },
  "AllowedHosts": "*",

  "TheTvDb": {
    "BaseUrl": "https://api4.thetvdb.com/v4/",
    "ApiKey": "",
    "Pin": ""
  },

  "Omdb": {
    "BaseUrl": "https://www.omdbapi.com/",
    "ApiKey": ""
  },
  "//Omdb": "ApiKey belongs in user-secrets (dev: dotnet user-secrets set \"Omdb:ApiKey\" \"<key>\") or env vars (prod: Omdb__ApiKey), never here.",

  "Mail": {
    "FromAddress": "no-reply@recall.local",
    "FromDisplayName": "Recall",
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "EnableSsl": true,
    "PickupDirectory": "",
    "BatchSize": 20,
    "MaxSendAttempts": 5
  },

  "Login": {
    "TokenLifetimeMinutes": 15,
    "ResendCooldownSeconds": 120,
    "InvalidatePreviousTokens": true,
    "AllowedEmails": [],
    "MaxRequestsPerEmailPerDay": 5,
    "MaxSignInEmailsPerHourSiteWide": 100
  },
  "//Login": "AllowedEmails is the registration allowlist; set it per env (empty = open, once bot defenses below are in place). Prod values come from .env.prod (Login__AllowedEmails__0, __1, ...). MaxRequestsPerEmailPerDay/MaxSignInEmailsPerHourSiteWide are in-memory abuse caps that matter most once the allowlist is empty.",

  "Turnstile": {
    "SiteKey": "",
    "SecretKey": ""
  },
  "//Turnstile": "Cloudflare Turnstile CAPTCHA on the sign-in form. Leave both empty to disable it (the form still works, just without this layer). Get free keys at https://dash.cloudflare.com (Turnstile) - SiteKey is public, SecretKey comes from .env.prod (Turnstile__SecretKey) and must never be committed.",

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=recall_db;Username=postgres;Password=devpassword",
    "RedisConnection": "localhost:6379"
  },
  
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Quartz.Core.QuartzSchedulerThread": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "flushToDiskInterval": "00:00:05"
        }
      }
    ]
  }
}
