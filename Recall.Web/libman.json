{
  "version": "3.0",
  "defaultProvider": "unpkg",
  "libraries": [
    {
      "library": "bootstrap@5.3.9",
      "destination": "wwwroot/lib/bootstrap/",
      "files": [
        "LICENSE",
        "dist/css/bootstrap.min.css",
        "dist/css/bootstrap.min.css.map",
        "dist/js/bootstrap.bundle.min.js",
        "dist/js/bootstrap.bundle.min.js.map"
      ]
    },
    {
      "library": "jquery@3.8.0",
      "destination": "wwwroot/lib/jquery/",
      "files": [
        "LICENSE.txt",
        "dist/jquery.min.js",
        "dist/jquery.min.map"
      ]
    },
    {
      "library": "jquery-validation@1.22.1",
      "destination": "wwwroot/lib/jquery-validation/",
      "files": [
        "LICENSE.md",
        "dist/jquery.validate.min.js"
      ]
    },
    {
      "library": "jquery-validation-unobtrusive@4.0.0",
      "destination": "wwwroot/lib/jquery-validation-unobtrusive/",
      "files": [
        "LICENSE.txt",
        "dist/jquery.validate.unobtrusive.min.js"
      ]
    },
    {
      "library": "@phosphor-icons/web@2.1.2",
      "destination": "wwwroot/lib/phosphor-icons/",
      "files": [
        "LICENSE",
        "src/regular/style.css",
        "src/regular/Phosphor.woff2",
        "src/fill/style.css",
        "src/fill/Phosphor-Fill.woff2"
      ]
    },
    {
      "library": "@fontsource/big-shoulders-display@5.3.0",
      "destination": "wwwroot/lib/fontsource/big-shoulders-display/",
      "files": [
        "LICENSE",
        "files/big-shoulders-display-latin-600-normal.woff2",
        "files/big-shoulders-display-latin-800-normal.woff2"
      ]
    },
    {
      "library": "@fontsource/ibm-plex-sans@5.3.0",
      "destination": "wwwroot/lib/fontsource/ibm-plex-sans/",
      "files": [
        "LICENSE",
        "files/ibm-plex-sans-latin-400-normal.woff2",
        "files/ibm-plex-sans-latin-500-normal.woff2",
        "files/ibm-plex-sans-latin-600-normal.woff2"
      ]
    },
    {
      "library": "@fontsource/ibm-plex-mono@5.3.0",
      "destination": "wwwroot/lib/fontsource/ibm-plex-mono/",
      "files": [
        "LICENSE",
        "files/ibm-plex-mono-latin-400-normal.woff2",
        "files/ibm-plex-mono-latin-500-normal.woff2"
      ]
    }
  ]
}
