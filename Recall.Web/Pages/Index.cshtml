@page
@model IndexModel
@{
    ViewData["Title"] = "Track TV Shows & Get Episode Alerts";
    ViewData["Description"] = "Recall.nu is a free TV show tracker. Track every series you " +
        "watch, get notified the moment a new episode airs, and build your list of favorites " +
        "— no password needed.";
    ViewData["Robots"] = "index, follow";
}

<div class="tvdb-shell">
    <div class="tvdb-empty-state">
        <div class="tvdb-slate--inline mb-3">
            <span class="tvdb-dot is-ok" aria-hidden="true"></span> FREE &middot; NO PASSWORD NEEDED
        </div>
        <h1 class="tvdb-display mb-3">Never miss the next episode.</h1>
        <p class="tvdb-prose text-muted mb-4 mx-auto" style="max-width: 34rem;">
            Track every show you watch, know the moment a new episode airs, and pick up right
            where you left off. Sign in with just your email — no password, no setup.
        </p>
        <a asp-page="/Account/Login" class="btn btn-primary btn-lg px-4">
            <i class="fa-solid fa-paper-plane me-1"></i> Get started — it's free
        </a>
    </div>

    <div class="row mt-4 g-4">
        <div class="col-md-4 text-center">
            <i class="fa-solid fa-list-check fa-2x mb-3" aria-hidden="true"></i>
            <h2 class="h5">Track everything you watch</h2>
            <p class="tvdb-prose text-muted">
                Build a library of every series you follow, and see at a glance what's new.
            </p>
        </div>
        <div class="col-md-4 text-center">
            <i class="fa-solid fa-bell fa-2x mb-3" aria-hidden="true"></i>
            <h2 class="h5">Get notified on air day</h2>
            <p class="tvdb-prose text-muted">
                We check for new episodes automatically and let you know the moment one airs.
            </p>
        </div>
        <div class="col-md-4 text-center">
            <i class="fa-solid fa-heart fa-2x mb-3" aria-hidden="true"></i>
            <h2 class="h5">Save your favorites</h2>
            <p class="tvdb-prose text-muted">
                Like shows and episodes to build up a running list of favorites over time.
            </p>
        </div>
    </div>

    <div class="row mt-5 justify-content-center text-center">
        <div class="col-lg-7">
            <h2 class="h4 mb-3">How it works</h2>
            <ol class="tvdb-prose text-muted text-start mx-auto mb-4" style="max-width: 30rem;">
                <li class="mb-2">Enter your email — no account or password to set up.</li>
                <li class="mb-2">Add the shows you're currently watching.</li>
                <li>Recall keeps track of what's aired and tells you when there's something new.</li>
            </ol>
            <a asp-page="/Account/Login" class="btn btn-outline-primary">Sign in</a>
        </div>
    </div>
</div>
