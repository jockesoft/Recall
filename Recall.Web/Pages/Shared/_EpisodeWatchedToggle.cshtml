@model Recall.Web.Pages.Shared.EpisodeWatchedToggleModel
@* The full-size button is named by its visible text ("Watched Fri, Sep 11"):
   WCAG 2.5.3 wants the visible label inside the accessible name, aria-pressed
   says it is on, and the title ("Mark as unwatched") becomes its description.
   Only the compact dot, which has no text, carries an aria-label. *@

<form method="post" asp-page-handler="@Model.Handler" asp-route-id="@Model.RouteId" class="d-inline tvdb-watch-form">
    @foreach (var field in Model.HiddenFields)
    {
        <input type="hidden" name="@field.Key" value="@field.Value" />
    }

    @if (Model.IsWatched)
    {
        <button type="submit"
                class="@(Model.Compact ? "tvdb-watch-dot tvdb-watch-dot--on" : "btn btn-watch--on")"
                title="Mark as unwatched"
                aria-pressed="true"
                aria-label="@(Model.Compact ? "Watched. Click to mark as unwatched." : null)">
            <i class="@Icons.Check" aria-hidden="true"></i>
            @if (!Model.Compact)
            {
                <text> @(Model.WatchedLabel ?? "Watched")</text>
            }
        </button>
    }
    else
    {
        <button type="submit"
                class="@(Model.Compact ? "tvdb-watch-dot" : "btn btn-primary")"
                title="Mark as watched"
                aria-pressed="false"
                aria-label="Mark as watched">
            @if (!Model.Compact)
            {
                <text>Mark as watched</text>
            }
        </button>
    }
</form>
