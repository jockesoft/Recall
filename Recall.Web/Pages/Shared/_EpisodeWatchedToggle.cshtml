@model Recall.Web.Pages.Shared.EpisodeWatchedToggleModel
@* Episode Details' watched button, named by its visible text ("Watched Fri,
   Sep 11"): WCAG 2.5.3 wants the visible label inside the accessible name,
   aria-pressed says it is on, and the title ("Mark as unwatched") becomes its
   description. (Episode rows use the round .tvdb-ep-mark of _SeasonCard.) *@

<form method="post" asp-page-handler="@Model.Handler" asp-route-id="@Model.RouteId" class="d-inline tvdb-watch-form">
    @foreach (var field in Model.HiddenFields)
    {
        <input type="hidden" name="@field.Key" value="@field.Value" />
    }

    @if (Model.IsWatched)
    {
        <button type="submit" class="btn btn-watch--on" title="Mark as unwatched" aria-pressed="true">
            <i class="@Icons.Check" aria-hidden="true"></i> @(Model.WatchedLabel ?? "Watched")
        </button>
    }
    else
    {
        <button type="submit" class="btn btn-primary" title="Mark as watched" aria-pressed="false" aria-label="Mark as watched">
            Mark as watched
        </button>
    }
</form>
