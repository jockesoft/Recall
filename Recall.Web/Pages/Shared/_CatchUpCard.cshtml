@model Recall.Web.Pages.Shared.CatchUpCardModel

<div class="tvdb-catchup-card">
    <div class="tvdb-catchup-media @(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "is-empty" : "")">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="" loading="lazy" />
        }

        @* Stretched link — the whole still opens the episode. Sits under the
           caption + button, which raise themselves above it. *@
        <a asp-page="/Episodes/Details" asp-route-id="@Model.EpisodeId"
           class="tvdb-catchup-hit" aria-label="@Model.EpisodeName"></a>

        <div class="tvdb-catchup-caption">
            <a asp-page="/Series/Details" asp-route-id="@Model.SeriesId" class="tvdb-catchup-show">@Model.SeriesName</a>
            @if (Model.SlateCode is not null)
            {
                <span class="tvdb-catchup-slate">@Model.SlateCode</span>
            }
            <span class="tvdb-catchup-ep">@Model.EpisodeName</span>
        </div>

        @* Rarely used actions for the series. The menu is positioned "fixed" so
           the frame's rounded clipping does not cut it off. *@
        <div class="dropdown tvdb-catchup-menu">
            <button type="button" class="tvdb-watch-badge tvdb-watch-badge--menu" id="@Model.MenuId"
                    data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false"
                    aria-label="More actions for @Model.SeriesName" title="More actions">
                <i class="@Icons.More" aria-hidden="true"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="@Model.MenuId">
                <li>
                    <form method="post" asp-page-handler="@Model.StopWatchingHandler" asp-route-seriesId="@Model.SeriesId">
                        <button type="submit" class="dropdown-item">Stop watching</button>
                    </form>
                </li>
            </ul>
        </div>

        <form method="post" asp-page-handler="@Model.MarkWatchedHandler"
              asp-route-seriesId="@Model.SeriesId" asp-route-episodeId="@Model.EpisodeId"
              class="tvdb-catchup-check">
            <button type="submit" class="tvdb-watch-badge"
                    title="Mark as watched"
                    aria-label="Mark @Model.EpisodeName as watched">
                <i class="@Icons.Check" aria-hidden="true"></i>
            </button>
        </form>
    </div>
</div>
