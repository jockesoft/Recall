@{
    var success = TempData["Toast.Success"] as string;
    var error = TempData["Toast.Error"] as string;
    var info = TempData["Toast.Info"] as string;

    // Set by SetSuccessToastWithWatchedUndo after a bulk "mark watched".
    var undoSeriesId = TempData[Recall.Web.Extensions.PageModelToastExtensions.UndoWatchedSeriesKey] as string;
    var undoStamp = TempData[Recall.Web.Extensions.PageModelToastExtensions.UndoWatchedStampKey] as string;
    var offerUndo = !string.IsNullOrWhiteSpace(success)
                    && int.TryParse(undoSeriesId, out _)
                    && long.TryParse(undoStamp, out _);
}

<div class="tvdb-toast-stack">
    @if (!string.IsNullOrWhiteSpace(success))
    {
        @* A toast offering an undo stays until dismissed (data-toast-persist skips the auto-close below). *@
        <div class="alert alert-success fade show" role="alert" data-toast-persist="@(offerUndo ? "true" : null)">
            <i class="@Icons.Success tvdb-toast-icon" aria-hidden="true"></i>
            <span class="tvdb-toast-text">@success</span>
            @if (offerUndo)
            {
                <form method="post" asp-page="/Series/Details" asp-page-handler="UndoWatched" asp-route-id="@undoSeriesId" class="d-inline-flex">
                    <input type="hidden" name="stamp" value="@undoStamp" />
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button type="submit" class="tvdb-toast-action">Undo</button>
                </form>
            }
            <button type="button" class="tvdb-close" data-bs-dismiss="alert" aria-label="Close"><i class="@Icons.Close" aria-hidden="true"></i></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger fade show" role="alert">
            <i class="@Icons.Error tvdb-toast-icon" aria-hidden="true"></i>
            <span class="tvdb-toast-text">@error</span>
            <button type="button" class="tvdb-close" data-bs-dismiss="alert" aria-label="Close"><i class="@Icons.Close" aria-hidden="true"></i></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(info))
    {
        <div class="alert alert-info fade show" role="alert">
            <i class="@Icons.Info tvdb-toast-icon" aria-hidden="true"></i>
            <span class="tvdb-toast-text">@info</span>
            <button type="button" class="tvdb-close" data-bs-dismiss="alert" aria-label="Close"><i class="@Icons.Close" aria-hidden="true"></i></button>
        </div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(success) || !string.IsNullOrWhiteSpace(error) || !string.IsNullOrWhiteSpace(info))
{
    <script>
        // Auto-dismiss toasts after a few seconds. Registered on DOMContentLoaded
        // rather than run immediately, since this partial renders near the top
        // of <body> — before bootstrap.bundle.min.js loads at the bottom — so
        // `bootstrap` wouldn't exist yet if this ran inline.
        document.addEventListener('DOMContentLoaded', function () {
            var toasts = document.querySelectorAll('.tvdb-toast-stack .alert');
            toasts.forEach(function (toastEl) {
                if (toastEl.hasAttribute('data-toast-persist')) return;
                setTimeout(function () {
                    if (typeof bootstrap === 'undefined') return;
                    var alert = bootstrap.Alert.getOrCreateInstance(toastEl);
                    alert.close();
                }, 5000);
            });
        });
    </script>
}
