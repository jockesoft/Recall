@using Recall.Web.Pages.Shared
@{
    // Every toast in the app is drawn here, from TempData, each by _Toast. How
    // long each stays is ToastDurations' call; js/tvdb-toasts.js (loaded by the
    // layout) runs the countdown, the pausing and Escape.
    var toasts = ToastMessagesModel.From(TempData).Toasts;
}

<div class="tvdb-toast-stack">
    @foreach (var toast in toasts)
    {
        <partial name="_Toast" model="toast" />
    }
</div>
