@model Recall.Web.Pages.Shared.CastListModel
@* A headed list of people (round photo or initials, name, character or jobs),
   in two columns, or one (Column). Collapsed until "Show all" is pressed: the
   stylesheet shows the first six or eight and does not render the rest, and
   the button appears only when someone is hidden (tvdb-cast.js: the count
   depends on the width). *@
@if (Model.People.Count > 0)
{
    var showAll = Model.ShowAllLabel ?? $"Show all {Model.People.Count}";
    <section class="tvdb-cast @(Model.Column ? "tvdb-cast--column" : "")" data-cast>
        <div class="tvdb-cast__head">
            <h2 class="mb-0">@Model.Heading <span class="tvdb-count">@Model.People.Count</span></h2>
            <button type="button" class="btn btn-outline-dark btn-sm tvdb-cast__toggle" data-cast-toggle
                    aria-expanded="false" aria-controls="@Model.Id" hidden>
                <span data-cast-toggle-label data-more="@showAll" data-less="Show fewer">@showAll</span>
                <i class="@Icons.Expand ms-1" aria-hidden="true"></i>
            </button>
        </div>

        <ul class="tvdb-cast__list list-unstyled" id="@Model.Id" aria-label="@Model.Heading">
            @foreach (var person in Model.People)
            {
                <li class="tvdb-person">
                    @if (!string.IsNullOrWhiteSpace(person.ImageUrl))
                    {
                        <img src="@person.ImageUrl" alt="" class="tvdb-person__photo tvdb-round-avatar tvdb-round-avatar--md" loading="lazy" />
                    }
                    else
                    {
                        <span class="tvdb-person__photo tvdb-round-avatar tvdb-round-avatar--md tvdb-round-avatar--initials" aria-hidden="true">@person.Initials</span>
                    }

                    @if (!string.IsNullOrWhiteSpace(person.Url))
                    {
                        <a class="tvdb-person__name tvdb-link-plain" href="@person.Url" target="_blank" rel="noopener noreferrer">@person.Name</a>
                    }
                    else
                    {
                        <span class="tvdb-person__name">@person.Name</span>
                    }

                    @if (!string.IsNullOrWhiteSpace(person.Detail))
                    {
                        <span class="tvdb-person__detail">@person.Detail</span>
                    }
                </li>
            }
        </ul>
    </section>
}
