@model Recall.Web.Pages.Shared.UpcomingEpisodeCardModel

<div class="tvdb-upcoming-card @(Model.SeriesCaughtUp ? "is-current" : "")">
    @* Stretched link — click anywhere on the card to open the episode. Sits
       under the series-name link, which raises itself above it. *@
    <a asp-page="/Episodes/Details" asp-route-id="@Model.LinkEpisodeId"
       class="tvdb-upcoming-hit"
       aria-label="@Model.SeriesName@(Model.SlateCode is null ? "" : $" {Model.SlateCode}")"></a>

    <div class="tvdb-thumb @(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "is-empty" : "")">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="" class="tvdb-thumb" loading="lazy" />
        }
        else
        {
            <span>No image</span>
        }
    </div>

    <div class="tvdb-upcoming-body">
        <a asp-page="/Series/Details" asp-route-id="@Model.SeriesId" class="tvdb-upcoming-series">@Model.SeriesName</a>

        @if (Model.SlateCode is not null || Model.DisplayEpisodeName is not null)
        {
            <div class="tvdb-upcoming-episode">
                @if (Model.SlateCode is not null)
                {
                    <span class="tvdb-slate--inline">@Model.SlateCode</span>
                }
                @if (Model.DisplayEpisodeName is not null)
                {
                    <span class="tvdb-upcoming-epname">@Model.DisplayEpisodeName</span>
                }
            </div>
        }

        @if (Model.IsPremiere || Model.IsFinale || Model.ExtraEpisodeCount > 0)
        {
            <div class="tvdb-upcoming-tags">
                @if (Model.IsPremiere)
                {
                    <span class="tvdb-badge tvdb-badge--ok">Premiere</span>
                }
                @if (Model.IsFinale)
                {
                    <span class="tvdb-badge tvdb-badge--amber">Finale</span>
                }
                @if (Model.ExtraEpisodeCount > 0)
                {
                    <span class="tvdb-badge tvdb-badge--neutral">+@Model.ExtraEpisodeCount more</span>
                }
            </div>
        }
    </div>

    @* The release date and time, rewritten into the viewer's zone in the browser
       (_ReleaseTime). Under "Today" / "Tomorrow" only the time is shown, if known. *@
    @if (Model.ShowDate)
    {
        <div class="tvdb-upcoming-when">
            <span class="tvdb-upcoming-date"><partial name="_ReleaseTime" model="@(new ReleaseTimeModel(Model.Release, Model.Today))" /></span>
            <span class="tvdb-upcoming-sep" aria-hidden="true">&middot;</span>
            <span class="tvdb-upcoming-countdown">@Model.Countdown</span>
        </div>
    }
    else if (Model.Release.IsTimeKnown)
    {
        <div class="tvdb-upcoming-when">
            <span class="tvdb-upcoming-date"><partial name="_ReleaseTime" model="@(new ReleaseTimeModel(Model.Release, Model.Today, TimeOnly: true))" /></span>
        </div>
    }
</div>
