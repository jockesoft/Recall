@inject Recall.Web.Services.ICurrentUserService CurrentUser
@{
    string buildNumber = "unknown";
    string path = System.IO.Path.Combine(AppContext.BaseDirectory, "build.txt");
    if (System.IO.File.Exists(path))
    {
        buildNumber = "v1.0." + System.IO.File.ReadAllText(path).Trim();
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Recall.nu</title>
    <link href="~/favicon.png" rel="icon" type="image/png" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/tvdb-theme.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Recall.Web.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.css" asp-append-version="false" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-page="/Index">
                <img src="~/images/banner.png" asp-append-version="true" alt="Recall" class="navbar-logo" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-page="/Series/Search">Search</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-page="/Series/Library">My Library</a>
                    </li>
                </ul>
                <ul class="navbar-nav align-items-sm-center">
                    @if (CurrentUser.IsAuthenticated)
                    {
                        <partial name="_NotificationBell" />
                        <li class="nav-item dropdown">
                            <a class="nav-link nav-avatar dropdown-toggle" href="#" id="accountMenu" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="~/images/mysteryman.jpg" asp-append-version="true" width="32" height="32"
                                     class="nav-avatar-img" alt="Account menu" />
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="accountMenu">
                                <li class="dropdown-header">
                                    <span class="d-block text-truncate">@(CurrentUser.DisplayName ?? "Signed in")</span>
                                    @if (!string.IsNullOrEmpty(CurrentUser.Email))
                                    {
                                        <span class="dropdown-header-sub d-block text-truncate">@CurrentUser.Email</span>
                                    }
                                </li>
                                <li><a class="dropdown-item" asp-page="/Account/Profile">Profile</a></li>
                                <li><a class="dropdown-item" asp-page="/Account/Notifications">Notifications</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" asp-page="/Account/Logout">
                                        <button type="submit" class="dropdown-item">Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Account/Login">Login</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container d-flex flex-wrap justify-content-between align-items-center py-2 gap-2">
        <div>
            &copy; 2026 - Recall.nu - <a asp-area="" asp-page="/Privacy">Privacy</a> - Version: @buildNumber
        </div>

        <div class="footer-attributions d-flex flex-wrap align-items-center gap-2">
            <a class="thetvdbattribution" href="https://thetvdb.com/subscribe" target="_blank" rel="noopener">
                <img src="/images/attribution/tvdb_logo.png" height="24" alt="TheTVDB logo">
                <span>Metadata provided by <strong>TheTVDB</strong></span>
            </a>

            <span class="omdbattribution" title="Some series data is adapted from OMDb API and used under the CC BY-NC 4.0 licence.">
                <span class="omdb-lead">Data adapted from </span><a href="https://www.omdbapi.com/" target="_blank" rel="noopener"><strong>OMDb API</strong></a>
                <span class="omdb-sep" aria-hidden="true">&middot;</span>
                <a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="license noopener">CC&nbsp;BY-NC&nbsp;4.0</a>
            </span>
        </div>
    </div>
</footer>

<partial name="_ToastMessages" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>