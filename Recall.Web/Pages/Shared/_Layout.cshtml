@inject Recall.Web.Services.ICurrentUserService CurrentUser
@{
    // The page being rendered ("/Dashboard", "/Account/Profile"), for aria-current in the navigation.
    var currentPage = ViewContext.RouteData.Values["page"] as string;
    string? CurrentIf(params string[] pages) =>
        pages.Any(p => string.Equals(p, currentPage, StringComparison.OrdinalIgnoreCase)) ? "page" : null;
    var homePage = CurrentUser.IsAuthenticated ? "/Dashboard" : "/Index";

    string buildNumber = "unknown";
    string path = System.IO.Path.Combine(AppContext.BaseDirectory, "build.txt");
    if (System.IO.File.Exists(path))
    {
        buildNumber = "v1.0." + System.IO.File.ReadAllText(path).Trim();
    }

    const string siteUrl = "https://recall.nu";

    var pageTitle = $"{ViewData["Title"]} - Recall.nu";
    var pageDescription = ViewData["Description"] as string
        ?? "Recall.nu is a free TV show tracker: follow the shows you watch, get notified "
        + "when new episodes air, and build a list of favorites.";

    // Default to noindex and let the public pages opt in via ViewData["Robots"]:
    // the landing page, Login, Privacy, and the Series/Episodes/Movies Details
    // pages (which are open to anonymous visitors and listed in the sitemap).
    // Everything else requires sign-in, so a crawler would only be redirected to
    // /Account/Login — and a new signed-in page is safe without anyone having to
    // remember to lock it down.
    var robotsDirective = ViewData["Robots"] as string ?? "noindex, nofollow";

    var requestPath = Context.Request.Path.Value ?? "/";
    var canonicalUrl = siteUrl + (requestPath == "/" ? "/" : requestPath.TrimEnd('/'));
    var ogImageUrl = siteUrl + Url.Content("~/images/og-image.png");

    var websiteJsonLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebSite",
        ["name"] = "Recall.nu",
        ["url"] = siteUrl + "/",
        ["description"] = pageDescription
    });
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription" />
    <meta name="robots" content="@robotsDirective" />
    <link rel="canonical" href="@canonicalUrl" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Recall.nu" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@ogImageUrl" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@pageDescription" />
    <meta name="twitter:image" content="@ogImageUrl" />

    <link rel="icon" href="~/favicon.ico" sizes="32x32" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <meta name="theme-color" content="#1f2733" />

    @* Order matters: Bootstrap, the icon fonts, then the theme (tokens → base → components → pages). *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/lib/phosphor-icons/src/regular/style.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/lib/phosphor-icons/src/fill/style.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true"/>
    <script type="application/ld+json">@Html.Raw(websiteJsonLd)</script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
<a class="tvdb-skip-link" href="#main">Skip to main content</a>
<header>
    <nav class="navbar navbar-expand-sm" aria-label="Main">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-page="@homePage">
                <img src="~/images/logo.svg" asp-append-version="true" alt="Recall" class="navbar-logo" width="150" height="32" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="@Icons.Menu" aria-hidden="true"></i>
            </button>
            <div class="navbar-collapse collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="@homePage" aria-current="@CurrentIf("/Dashboard", "/Index")">Home</a>
                    </li>
                    @if (CurrentUser.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Search" aria-current="@CurrentIf("/Search")">Search</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Library" aria-current="@CurrentIf("/Library")">My Library</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav align-items-sm-center">
                    @if (CurrentUser.IsAuthenticated)
                    {
                        @* Phones: the collapsed menu shows who is signed in (avatar beside
                           name and email) and the account links as plain rows. The avatar
                           dropdown below is for wider screens only. *@
                        <li class="nav-identity d-sm-none">
                            <partial name="_Avatar" model="@(new AvatarModel(CurrentUser.DisplayName, "md"))" />
                            <span class="nav-identity__text">
                                <span class="nav-identity__name text-truncate">@(CurrentUser.DisplayName ?? "Signed in")</span>
                                @if (!string.IsNullOrEmpty(CurrentUser.Email))
                                {
                                    <span class="nav-identity__email text-truncate">@CurrentUser.Email</span>
                                }
                            </span>
                        </li>
                        <li class="nav-item d-sm-none">
                            <a class="nav-link" asp-page="/Account/Profile" aria-current="@CurrentIf("/Account/Profile")">Profile</a>
                        </li>
                        <li class="nav-item d-sm-none">
                            <a class="nav-link" asp-page="/Account/Favorites" aria-current="@CurrentIf("/Account/Favorites")">Favorites</a>
                        </li>
                        <partial name="_NotificationBell" />
                        @if (CurrentUser.IsAdmin)
                        {
                            <li class="nav-item d-sm-none">
                                <a class="nav-link" asp-page="/Admin/Index" aria-current="@CurrentIf("/Admin/Index")">Admin panel</a>
                            </li>
                        }
                        <li class="nav-item d-sm-none">
                            <form method="post" asp-page="/Account/Logout">
                                <button type="submit" class="nav-link nav-link-button">Logout</button>
                            </form>
                        </li>
                        <li class="nav-item dropdown d-none d-sm-block">
                            <a class="nav-link nav-avatar dropdown-toggle" href="#" id="accountMenu" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
                                <partial name="_Avatar" model="@(new AvatarModel(CurrentUser.DisplayName))" />
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="accountMenu">
                                <li class="dropdown-header">
                                    <span class="d-block text-truncate">@(CurrentUser.DisplayName ?? "Signed in")</span>
                                    @if (!string.IsNullOrEmpty(CurrentUser.Email))
                                    {
                                        <span class="dropdown-header-sub d-block text-truncate">@CurrentUser.Email</span>
                                    }
                                </li>
                                <li><a class="dropdown-item" asp-page="/Account/Profile" aria-current="@CurrentIf("/Account/Profile")">Profile</a></li>
                                <li><a class="dropdown-item" asp-page="/Account/Favorites" aria-current="@CurrentIf("/Account/Favorites")">Favorites</a></li>
                                <li><a class="dropdown-item" asp-page="/Account/Notifications" aria-current="@CurrentIf("/Account/Notifications")">Notifications</a></li>
                                @if (CurrentUser.IsAdmin)
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-page="/Admin/Index" aria-current="@CurrentIf("/Admin/Index")">
                                            <i class="@Icons.AdminPanel tvdb-icon--fw me-1" aria-hidden="true"></i>Admin panel
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" asp-page="/Account/Logout">
                                        <button type="submit" class="dropdown-item">Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Account/Login" aria-current="@CurrentIf("/Account/Login")">Login</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main id="main" role="main" tabindex="-1" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="footer">
    <div class="container py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-4">
            <div class="footer-support">
                <div class="footer-support__title">Support &amp; contact</div>
                <p class="footer-support__text">
                    Questions, feedback or something not working? Message us on our Facebook
                    page and we'll get back to you.
                </p>
                <a class="footer-social" href="https://www.facebook.com/profile.php?id=61594107509642"
                   target="_blank" rel="noopener" aria-label="Recall on Facebook">
                    <i class="@Icons.Facebook" aria-hidden="true"></i>
                    <span>Recall on Facebook</span>
                </a>
            </div>

            <div class="footer-attributions d-flex flex-wrap align-items-center gap-2">
                <a class="thetvdbattribution" href="https://thetvdb.com" target="_blank" rel="noopener">
                    <img src="/images/attribution/tvdb_logo.png" height="24" alt="TheTVDB logo">
                    <span>Metadata provided by <strong>TheTVDB</strong></span>
                </a>

                <span class="omdbattribution" title="Some series data is adapted from OMDb API and used under the CC BY-NC 4.0 licence.">
                    <span class="omdb-lead">Data adapted from </span><a href="https://www.omdbapi.com/" target="_blank" rel="noopener"><strong>OMDb API</strong></a>
                    <span class="omdb-sep" aria-hidden="true">&middot;</span>
                    <a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="license noopener">CC&nbsp;BY-NC&nbsp;4.0</a>
                </span>
            </div>
        </div>

        <div class="footer-legal">
            &copy; 2026 Recall.nu <span aria-hidden="true">&middot;</span>
            <a asp-area="" asp-page="/Privacy">Privacy</a> <span aria-hidden="true">&middot;</span>
            Version @buildNumber
        </div>
    </div>
</footer>

<partial name="_ToastMessages" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)

<div id="cookieNotice" class="cookie-notice" role="region" aria-label="About cookies" hidden>
    <p class="cookie-notice__text">
        We only use cookies required for the site to work — for example, keeping you signed in.
        No tracking or advertising cookies, so there's nothing to opt out of.
        <a asp-page="/Privacy" asp-fragment="cookies">Learn more</a>.
    </p>
    <button type="button" id="cookieNoticeDismiss" class="btn btn-primary btn-sm cookie-notice__button">
        Got it
    </button>
</div>
<script>
    // Inline (not in an external script) so it runs before paint: a returning visitor who
    // already dismissed this never sees it flash on screen.
    (function () {
        "use strict";
        var STORAGE_KEY = "recall.cookie-notice-dismissed";
        var notice = document.getElementById("cookieNotice");
        if (!notice) return;

        var alreadyDismissed = false;
        try {
            alreadyDismissed = window.localStorage.getItem(STORAGE_KEY) === "1";
        } catch (e) {
            // Storage unavailable (private mode, blocked, etc.) — just show the notice.
        }

        if (!alreadyDismissed) {
            notice.hidden = false;
        }

        var dismissButton = document.getElementById("cookieNoticeDismiss");
        if (dismissButton) {
            dismissButton.addEventListener("click", function () {
                notice.hidden = true;
                try {
                    window.localStorage.setItem(STORAGE_KEY, "1");
                } catch (e) {
                    // Nothing to do — worst case the notice reappears next visit.
                }
            });
        }
    })();
</script>
</body>
</html>