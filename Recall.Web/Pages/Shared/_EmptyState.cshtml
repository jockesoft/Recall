@model Recall.Web.Pages.Shared.EmptyStateModel
@{
    var headingTag = Model.HeadingLevel switch { 1 => "h1", 3 => "h3", _ => "h2" };
}

<div class="tvdb-empty-state @(Model.Inline ? "tvdb-empty-state--inline" : null)">
    <span class="tvdb-empty-state__icon"><i class="@Model.Icon" aria-hidden="true"></i></span>
    @Html.Raw($"<{headingTag} class=\"tvdb-empty-state__title\">")@Model.Heading@Html.Raw($"</{headingTag}>")
    <p class="tvdb-empty-state__text">@Model.Text</p>
    @{
        var hasAction = !string.IsNullOrWhiteSpace(Model.ActionText) && !string.IsNullOrWhiteSpace(Model.ActionPage);
        var hasSecondary = !string.IsNullOrWhiteSpace(Model.SecondaryActionText) && !string.IsNullOrWhiteSpace(Model.SecondaryActionPage);
    }
    @if (hasAction || hasSecondary)
    {
        <div class="tvdb-empty-state__actions">
            @if (hasAction)
            {
                <a asp-page="@Model.ActionPage" asp-route-id="@Model.ActionRouteId" class="btn btn-primary">@Model.ActionText</a>
            }
            @if (hasSecondary)
            {
                <a asp-page="@Model.SecondaryActionPage" class="btn btn-outline-dark">@Model.SecondaryActionText</a>
            }
        </div>
    }
</div>
