@using Recall.Web.Pages.Shared
@model Recall.Web.Pages.Shared.SeriesCardModel
@{
    var showProgress = Model.WatchedEpisodes > 0 && Model.ReleasedEpisodes > 0;
    var watched = Math.Min(Model.WatchedEpisodes, Model.ReleasedEpisodes);
    var percent = showProgress ? (int)Math.Round(100.0 * watched / Model.ReleasedEpisodes) : 0;
    var isComplete = showProgress && watched >= Model.ReleasedEpisodes;
}

<div class="tvdb-series-card-wrap" data-content-type="@Model.BadgeVariant">
    <a asp-page="@Model.DetailsPage" asp-route-id="@Model.TvdbId" class="tvdb-series-card">
        <span class="tvdb-series-poster @(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "is-empty" : "")">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="" loading="lazy" />
            }

            @if (!string.IsNullOrWhiteSpace(Model.BadgeIcon))
            {
                <span class="tvdb-series-badge tvdb-series-badge--@Model.BadgeVariant" title="@Model.BadgeLabel" aria-label="@Model.BadgeLabel">
                    <i class="fa-solid @Model.BadgeIcon" aria-hidden="true"></i>
                </span>
            }

            @if (showProgress)
            {
                <span class="tvdb-series-progress @(isComplete ? "is-complete" : "")"
                      role="progressbar"
                      aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"
                      aria-label="@Model.WatchedEpisodes of @Model.ReleasedEpisodes episodes watched">
                    <span class="tvdb-series-progress-fill" style="width: @percent%"></span>
                </span>
            }
        </span>

        <span class="tvdb-series-title">@Model.Name</span>

        @if (!string.IsNullOrWhiteSpace(Model.Caption))
        {
            <span class="tvdb-series-year">@Model.Caption</span>
        }
        else if (Model.FirstAired.HasValue)
        {
            <span class="tvdb-series-year">@Model.FirstAired.Value.Year</span>
        }
    </a>

    @if (Model.ShowLike)
    {
        <div class="tvdb-series-card-like">
            <partial name="_LikeToggle" model="@(new LikeToggleModel
                     {
                         Handler = Model.LikeHandler,
                         RouteId = Model.TvdbId,
                         HiddenFields = Model.LikeHiddenFields,
                         IsLiked = Model.IsLiked,
                         TargetNoun = Model.LikeTargetNoun
                     })" />
        </div>
    }
</div>
