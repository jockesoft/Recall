@using Recall.Web.Pages.Shared
@model Recall.Web.Pages.Shared.SeriesCardModel
@{
    var showProgress = Model.WatchedEpisodes > 0 && Model.ReleasedEpisodes > 0;
    var watched = Math.Min(Model.WatchedEpisodes, Model.ReleasedEpisodes);
    var percent = showProgress ? (int)Math.Round(100.0 * watched / Model.ReleasedEpisodes) : 0;
    var isComplete = showProgress && watched >= Model.ReleasedEpisodes;
}

<div class="tvdb-series-card-wrap" data-content-type="@Model.ContentType" id="@Model.ElementId">
    <a asp-page="@Model.DetailsPage" asp-route-id="@Model.TvdbId" class="tvdb-series-card">
        <span class="tvdb-series-poster @(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "is-empty" : "")">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="" loading="lazy" />
            }

            @if (showProgress)
            {
                <span class="tvdb-series-progress @(isComplete ? "is-complete" : "")"
                      role="progressbar"
                      aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"
                      aria-label="@Model.WatchedEpisodes of @Model.ReleasedEpisodes episodes watched">
                    <span class="tvdb-series-progress-fill" style="width: @percent%"></span>
                </span>
            }
        </span>

        <span class="tvdb-series-title">@Model.Name</span>

        @if (!string.IsNullOrWhiteSpace(Model.ProgressText))
        {
            <span class="tvdb-series-progress-text">@Model.ProgressText</span>
        }

        <span class="tvdb-series-year">@Model.MetaLine</span>
    </a>

    @if (Model.MarkEpisodeId is { } markEpisodeId)
    {
        @* The one-tap mark, in the poster's bottom-right corner above the
           progress bar: an overlay the size of the poster that lets clicks
           through to the card except on the button. *@
        <div class="tvdb-series-card-mark">
            <form method="post" asp-page-handler="@Model.MarkHandler"
                  asp-route-seriesId="@Model.TvdbId" asp-route-episodeId="@markEpisodeId">
                @foreach (var field in Model.MarkHiddenFields)
                {
                    <input type="hidden" name="@field.Key" value="@field.Value" />
                }
                @if (Model.ElementId is not null)
                {
                    <input type="hidden" name="Anchor" value="@Model.ElementId" />
                }
                @if (Model.IsLastInList)
                {
                    <input type="hidden" name="last" value="true" />
                }
                <button type="submit" class="tvdb-round-button tvdb-round-button--lg tvdb-round-button--on-image"
                        title="Mark as watched" aria-label="@Model.MarkLabel">
                    <i class="@Icons.Check" aria-hidden="true"></i>
                </button>
            </form>
        </div>
    }

    @if (Model.ShowLike)
    {
        <div class="tvdb-series-card-like">
            <partial name="_LikeToggle" model="@(new LikeToggleModel
                     {
                         Handler = Model.LikeHandler,
                         RouteId = Model.TvdbId,
                         HiddenFields = Model.LikeHiddenFields,
                         IsLiked = Model.IsLiked,
                         TargetNoun = Model.LikeTargetNoun,
                         Placement = LikePlacement.Image
                     })" />
        </div>
    }
</div>
