@inject Recall.Web.Services.ICurrentUserService CurrentUser
@inject Recall.Web.Services.Notifications.INotificationService NotificationService
@{
    var unread = 0;

    if (CurrentUser.UserId is { } bellUserId)
    {
        try
        {
            unread = await NotificationService.GetUnreadCountAsync(bellUserId, Context.RequestAborted);
        }
        catch
        {
            // The bell must never take down a page render.
            unread = 0;
        }
    }

    var badgeText = unread > 99 ? "99+" : unread.ToString();
    var isCurrent = string.Equals(ViewContext.RouteData.Values["page"] as string, "/Account/Notifications", StringComparison.OrdinalIgnoreCase);
}

<li class="nav-item">
    <a class="nav-link nav-bell @(unread > 0 ? "has-unread" : null)"
       asp-page="/Account/Notifications" title="Notifications" aria-current="@(isCurrent ? "page" : null)"
       aria-label="@(unread > 0 ? $"Notifications, {unread} unread" : "Notifications")">
        <i class="@Icons.Bell" aria-hidden="true"></i>
        @* Shown in the collapsed phone menu, where the bell is a row among rows. *@
        <span class="nav-bell-label" aria-hidden="true">Notifications</span>
        @if (unread > 0)
        {
            <span class="nav-bell-badge" aria-hidden="true">@badgeText</span>
        }
    </a>
</li>
