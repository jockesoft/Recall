@page "{id:int}"
@model Recall.Web.Pages.Episodes.DetailsModel

@{
    var ep = Model.Episode;
    ViewData["Title"] = ep?.Name ?? "Episode";
    ViewData["Description"] = !string.IsNullOrWhiteSpace(ep?.Overview)
        ? (ep.Overview.Length <= 300 ? ep.Overview : ep.Overview[..300].TrimEnd() + "…")
        : $"Details and ratings for {(ep?.Name ?? "this episode")}{(Model.SeriesName is not null ? $" from {Model.SeriesName}" : "")} on Recall.nu.";
    ViewData["Robots"] = ep is not null ? "index, follow" : "noindex, nofollow";
}

@Html.AntiForgeryToken()

@if (ep is null)
{
    var cameFrom = Model.CameFromSeriesId;
    <div class="tvdb-shell">
        @if (cameFrom is { } backTo)
        {
            <a class="tvdb-back-link" asp-page="/Series/Details" asp-route-id="@backTo"><i class="@Icons.Back" aria-hidden="true"></i> Back to the series</a>
        }

        <partial name="_EmptyState" model="@(new EmptyStateModel
                 {
                     Icon = Model.LoadFailed ? Icons.Problem : Icons.NotFound,
                     Heading = Model.LoadFailed ? "This episode couldn't be loaded" : "Episode not found",
                     Text = Model.LoadFailed
                         ? "TheTVDB, where the episode information comes from, isn't answering right now. Please try again in a little while."
                         : "There is no episode at this address. It may have been removed from TheTVDB.",
                     HeadingLevel = 1,
                     ActionText = cameFrom is null ? "Go to the home page" : "Back to the series",
                     ActionPage = cameFrom is null ? "/Index" : "/Series/Details",
                     ActionRouteId = cameFrom
                 })" />
    </div>
}
else
{
    var today = Model.Today;

    <partial name="_TitleHero" model="@Model.BuildHero()" />

    <div class="tvdb-shell tvdb-shell--below-hero">
        <div class="tvdb-detail-layout">
            <div class="tvdb-detail-layout__main">
                <section id="overview" class="tvdb-detail-section" aria-labelledby="overviewHeading">
                    <h2 id="overviewHeading">Overview</h2>
                    @if (!string.IsNullOrWhiteSpace(ep.Overview))
                    {
                        <p class="tvdb-prose">@ep.Overview</p>
                    }
                    else
                    {
                        <p class="tvdb-prose text-muted fst-italic">No overview available for this episode yet.</p>
                    }

                    <dl class="tvdb-fact-list">
                        @if (Model.Release is { } release)
                        {
                            <div>
                                <dt>@(Model.HasAired ? "Aired" : "Airs")</dt>
                                <dd><partial name="_ReleaseTime" model="@(new ReleaseTimeModel(release, today))" /></dd>
                            </div>
                        }
                        @if (Model.RuntimeMinutes is > 0 and var minutes)
                        {
                            <div>
                                <dt>Runtime</dt>
                                <dd>@TitleSummary.Runtime(minutes)</dd>
                            </div>
                        }
                        @if (Model.ImdbRating is { } imdb)
                        {
                            <div>
                                <dt>IMDb</dt>
                                <dd>
                                    <i class="@Icons.Star tvdb-rating-star" aria-hidden="true"></i>
                                    <span class="tvdb-mono">@imdb</span>&#8202;/&#8202;10
                                    @if (Model.ImdbVotes is { } votes)
                                    {
                                        <span class="tvdb-meta">· @votes votes</span>
                                    }
                                </dd>
                            </div>
                        }
                    </dl>

                    @if (ep.Awards.Count > 0)
                    {
                        <h3 class="tvdb-episode-awards__heading">Awards</h3>
                        <ul class="tvdb-episode-awards list-unstyled">
                            @foreach (var award in ep.Awards)
                            {
                                <li>
                                    <span class="tvdb-badge @(award.IsWinner ? "tvdb-badge--amber" : "tvdb-badge--neutral")">@(award.IsWinner ? "Won" : "Nominated")</span>
                                    <span class="tvdb-meta">
                                        @award.Name@(award.Year is not null ? $" ({award.Year})" : "")@if (!string.IsNullOrWhiteSpace(award.Category))
                                        {
                                            <text> · @award.Category</text>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>

            @if (Model.GuestStars.Count > 0)
            {
                <div class="tvdb-detail-layout__side">
                    <div id="guest-stars" class="tvdb-detail-people">
                        <partial name="_CastList" model="@(new CastListModel { Heading = "Guest stars", Id = "guestStarsList", People = Model.GuestStars, Column = true })" />
                    </div>
                </div>
            }
        </div>

        @if (Model.PreviousEpisode is not null || Model.NextEpisode is not null)
        {
            @* Two cards across the panel; a missing side keeps its space. *@
            <nav class="tvdb-episode-nav" aria-label="Previous and next episode">
                @foreach (var (link, label, icon, side) in new[]
                         {
                             (Model.PreviousEpisode, "Previous", Icons.Back, "prev"),
                             (Model.NextEpisode, "Next", Icons.Next, "next")
                         })
                {
                    if (link is null)
                    {
                        <span class="tvdb-episode-nav__gap" aria-hidden="true"></span>
                        continue;
                    }

                    <a class="tvdb-episode-nav__card tvdb-episode-nav__card--@side" asp-page="/Episodes/Details" asp-route-id="@link.Id" rel="@side">
                        <span class="tvdb-episode-nav__label"><i class="@icon" aria-hidden="true"></i> @label</span>
                        <span class="tvdb-episode-nav__title">@if (link.Code is not null)
                            {<span class="tvdb-mono">@link.Code</span>@(link.Title is null ? "" : " · ")}@link.Title</span>
                    </a>
                }
            </nav>
        }

        <p class="tvdb-source-line">
            @if (!string.IsNullOrWhiteSpace(Model.SeriesSlug))
            {
                <a class="tvdb-metalink" href="https://www.thetvdb.com/series/@Model.SeriesSlug/episodes/@ep.Id" target="_blank" rel="noopener">TheTVDB <span class="tvdb-mono">@ep.Id</span></a>
            }
            else
            {
                <span>TheTVDB <span class="tvdb-mono">@ep.Id</span></span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ImdbId))
            {
                <a class="tvdb-metalink" href="https://www.imdb.com/title/@Model.ImdbId" target="_blank" rel="noopener">IMDb <span class="tvdb-mono">@Model.ImdbId</span></a>
            }
        </p>
    </div>

    @if (Model.IsAuthenticated)
    {
        <partial name="_CatchUpModal" model="@(new CatchUpModalModel
                 {
                     RouteId = ep.Id!.Value,
                     JustThisHandler = "ToggleWatched",
                     ThroughHandler = "MarkWatchedThrough"
                 })" />
    }
}

@section Scripts {
    @if (ep is not null)
    {
        <script src="~/js/tvdb-cast.js" asp-append-version="true"></script>
        <script src="~/js/tvdb-share.js" asp-append-version="true"></script>
        <script src="~/js/tvdb-series.js" asp-append-version="true"></script>
    }
}

@section Head {
    @if (ep is not null)
    {
        <script type="application/ld+json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "TVEpisode",
            ["name"] = ep.Name,
            ["description"] = ViewData["Description"],
            ["image"] = Model.Art.StillUrl,
            ["episodeNumber"] = ep.Number,
            ["seasonNumber"] = ep.SeasonNumber,
            ["partOfSeries"] = Model.SeriesName is null ? null : new Dictionary<string, object?>
            {
                ["@type"] = "TVSeries",
                ["name"] = Model.SeriesName
            }
        }))</script>
    }
}
