@page
@model VerifyModel
@{
    ViewData["Title"] = "Sign-in link";
}

<div class="tvdb-shell tvdb-shell--narrow">
    <partial name="_EmptyState" model="@(new EmptyStateModel
             {
                 Icon = Icons.Problem,
                 Heading = "This sign-in link didn't work",
                 Text = "It may have expired, already been used, or been copied incompletely. Request a fresh one and try again.",
                 HeadingLevel = 1,
                 ActionText = "Back to sign in",
                 ActionPage = "/Account/Login"
             })" />
</div>
