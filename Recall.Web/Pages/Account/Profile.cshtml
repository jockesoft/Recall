@page
@using Recall.Web.Domain.TheTvDb
@using Recall.Web.Pages.Shared
@model Recall.Web.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Profile";
}

@functions {
    static SeriesCardModel ToCardModel(Recall.Web.Services.Favorites.Models.FavoriteTitle title) => new()
    {
        TvdbId = title.TvdbId,
        Name = title.Name,
        ImageUrl = title.ImageUrl,
        FirstAired = title.FirstAired,
        WatchedEpisodes = title.WatchedEpisodes,
        ReleasedEpisodes = title.ReleasedEpisodes,
        DetailsPage = title.Type == SearchResultType.Movie ? "/Movies/Details" : "/Series/Details",
        IsMovie = title.Type == SearchResultType.Movie,
        LikeHandler = title.Type == SearchResultType.Movie ? "ToggleMovieLike" : "ToggleSeriesLike",
        LikeTargetNoun = title.Type == SearchResultType.Movie ? "movie" : "series",
        ShowLike = true,
        IsLiked = true
    };
}

<div class="tvdb-shell">
    <header class="tvdb-profile-head">
        <partial name="_Avatar" model="@(new AvatarModel(Model.DisplayName, "lg"))" />
        <div class="tvdb-profile-head__who">
            <h1 class="mb-0 text-truncate">@Model.DisplayName</h1>
            <div class="tvdb-meta text-truncate">@Model.Email</div>
        </div>
        @if (Model.WatchTime.HasData)
        {
            @* The figure is the way in to Stats, which is computed from the same total. *@
            <a asp-page="/Account/Stats" class="tvdb-profile-stat" id="profileWatchTime">
                <span class="tvdb-profile-stat__value">@Model.WatchTime.Readable</span>
                <span class="tvdb-profile-stat__label">watched, across @Model.WatchTime.Across</span>
                <span class="tvdb-profile-stat__more">See your stats <i class="@Icons.Forward" aria-hidden="true"></i></span>
            </a>
        }
    </header>

    <section class="tvdb-page-section">
        <div class="tvdb-section-head">
            <h2 class="mb-0">Favorites</h2>
            @if (Model.FavoriteTitles.Count > 0)
            {
                <a asp-page="/Account/Favorites" class="tvdb-section-head__link">See all <i class="@Icons.Forward" aria-hidden="true"></i></a>
            }
        </div>

        @if (Model.FavoriteTitles.Count == 0)
        {
            <p class="tvdb-meta mb-0">
                No favorites yet. Tap the heart on a series, a movie or an episode to keep it here.
                <a asp-page="/Account/Favorites">Open favorites</a>
            </p>
        }
        else
        {
            <div class="tvdb-poster-row" tabindex="0" role="group" aria-label="Favorite titles">
                @foreach (var title in Model.FavoriteTitles)
                {
                    <partial name="_SeriesCard" model="@ToCardModel(title)" />
                }
            </div>
        }
    </section>

    <section class="tvdb-page-section">
        <h2>Import</h2>
        <p class="mb-2">@Model.ImportSummary</p>
        <a asp-page="/Account/ImportWatchlist" class="btn btn-outline-dark btn-sm">
            @(Model.LatestImportJob is null ? "Import from IMDb" : "View import")
        </a>
    </section>

    @if (Model.PushAvailable)
    {
        @* What this browser can do is only known in the browser: tvdb-push.js
           shows one of the data-push-state blocks and never asks for permission
           until "Turn on" is pressed. *@
        <section class="tvdb-page-section" id="push" data-push data-push-key="@Model.PushPublicKey">
            <h2>Notifications</h2>
            @* Label above its content on a phone: the instructions need the width. *@
            <dl class="row mb-3">
                <dt class="col-12 col-sm-3">This device</dt>
                <dd class="col-12 col-sm-9">
                    <noscript>
                        <span class="tvdb-meta">Notifications need JavaScript, which is turned off in this browser.</span>
                    </noscript>
                    <div data-push-state="checking" hidden>
                        <span class="tvdb-meta">Checking what this browser supports…</span>
                    </div>
                    <div class="tvdb-setting" data-push-state="off" hidden>
                        <span class="tvdb-setting__state">
                            <strong>Off</strong>
                            <span class="tvdb-meta">Get a notification here when a new episode of a series you follow is out.</span>
                        </span>
                        <button type="button" class="btn btn-outline-dark btn-sm" id="pushSwitchOn">Turn on</button>
                    </div>
                    <div class="tvdb-setting" data-push-state="on" hidden>
                        <span class="tvdb-setting__state">
                            <strong>On</strong>
                            <span class="tvdb-meta">This device gets a notification when new episodes are out.</span>
                        </span>
                        <button type="button" class="btn btn-outline-dark btn-sm" id="pushSwitchOff">Turn off</button>
                    </div>
                    <div data-push-state="ios" hidden>
                        <p class="mb-1"><strong>Add Recall to your Home Screen to get notifications</strong></p>
                        <ol class="tvdb-steps mb-0">
                            <li>Tap the Share button <i class="@Icons.Share" aria-hidden="true"></i> in Safari.</li>
                            <li>Choose <em>Add to Home Screen</em>.</li>
                            <li>Open Recall from the Home Screen and sign in there with the code from the sign-in email.</li>
                            <li>Turn notifications on here, in the app.</li>
                        </ol>
                    </div>
                    <div data-push-state="unsupported" hidden>
                        <span class="tvdb-meta">This browser can't show notifications from websites. A recent Chrome, Edge, Firefox or Safari can.</span>
                    </div>
                    <div data-push-state="denied" hidden>
                        <p class="mb-1"><strong>Notifications are blocked for Recall in this browser.</strong></p>
                        <p class="tvdb-meta mb-0">
                            To allow them, open the site settings (the icon at the left of the address bar), set
                            Notifications to Allow and reload this page. On a phone, also check that notifications
                            are allowed for the browser, or for Recall on an iPhone, in the phone's Settings.
                        </p>
                    </div>
                    <p class="tvdb-field-message text-danger mb-0" data-push-error role="status" hidden></p>
                </dd>

                <dt class="col-12 col-sm-3">Quiet hours</dt>
                <dd class="col-12 col-sm-9">
                    <form method="post" asp-page-handler="SetQuietHours" class="tvdb-setting">
                        <input type="hidden" name="on" value="@(Model.PushQuietHours ? "false" : "true")" />
                        <span class="tvdb-setting__state">
                            <strong>@(Model.PushQuietHours ? "On" : "Off")</strong>
                            <span class="tvdb-meta">
                                @(Model.PushQuietHours
                                    ? "22:00–08:00 on each device: notifications due then wait until 08:00."
                                    : "Notifications arrive whatever the time. Turn on to hold them 22:00–08:00 on each device.")
                            </span>
                        </span>
                        <button type="submit" class="btn btn-outline-dark btn-sm" id="quietHoursSwitch">
                            @(Model.PushQuietHours ? "Turn off" : "Turn on")
                        </button>
                    </form>
                </dd>
            </dl>

            <h3>Your devices</h3>
            @if (Model.PushDevices.Count == 0)
            {
                <p class="tvdb-meta mb-0">No devices yet. Turn notifications on above, on each phone or computer you want them on.</p>
            }
            else
            {
                <ul class="tvdb-device-list list-unstyled mb-0">
                    @foreach (var device in Model.PushDevices)
                    {
                        <li class="tvdb-device" data-endpoint-hash="@device.EndpointHash">
                            <i class="@Icons.Device tvdb-icon--md" aria-hidden="true"></i>
                            <div class="tvdb-device__body">
                                <div class="tvdb-device__title">
                                    @device.Label
                                    <span class="tvdb-device__this" data-this-device hidden>This device</span>
                                </div>
                                <div class="tvdb-meta">@device.TimeZone · added @device.Added</div>
                            </div>
                            <form method="post" asp-page-handler="RemoveDevice" asp-route-id="@device.Id" data-remove-device>
                                <button type="submit" class="btn btn-outline-dark btn-sm" aria-label="Remove @device.Label">Remove</button>
                            </form>
                        </li>
                    }
                </ul>
            }

            @* Filled in and sent by tvdb-push.js: ordinary forms, so the antiforgery token and the toast work as everywhere else. *@
            <form method="post" asp-page-handler="SubscribeDevice" id="pushSubscribeForm" hidden>
                <input type="hidden" name="endpoint" />
                <input type="hidden" name="p256dh" />
                <input type="hidden" name="auth" />
                <input type="hidden" name="timeZone" />
            </form>
            <form method="post" asp-page-handler="UnsubscribeDevice" id="pushUnsubscribeForm" hidden>
                <input type="hidden" name="endpoint" />
            </form>
        </section>
    }

    <section class="tvdb-page-section">
        <h2>Account</h2>
        <dl class="row mb-3">
            <dt class="col-5 col-sm-3">Username</dt>
            <dd class="col-7 col-sm-9">
                <span class="d-inline-flex align-items-center gap-2 flex-wrap">
                    @Model.DisplayName
                    <a asp-page="/Account/EditProfile" class="tvdb-inline-edit" aria-label="Edit username">Edit</a>
                </span>
            </dd>

            <dt class="col-5 col-sm-3">Email</dt>
            <dd class="col-7 col-sm-9">@Model.Email</dd>

            <dt class="col-5 col-sm-3">Role</dt>
            <dd class="col-7 col-sm-9">
                <span class="tvdb-role-badge @Model.RoleBadge.CssModifier">
                    <i class="@Model.RoleBadge.Icon" aria-hidden="true"></i> @Model.RoleBadge.Label
                </span>
            </dd>

            <dt class="col-5 col-sm-3">Sign-in</dt>
            <dd class="col-7 col-sm-9">Emailed sign-in link. No password is stored.</dd>

            @if (Model.DigestAvailable)
            {
                <dt class="col-5 col-sm-3">Weekly email</dt>
                <dd class="col-7 col-sm-9">
                    <form method="post" asp-page-handler="SetDigest" class="tvdb-setting">
                        <input type="hidden" name="on" value="@(Model.DigestOn ? "false" : "true")" />
                        <span class="tvdb-setting__state">
                            <strong>@(Model.DigestOn ? "On" : "Off")</strong>
                            <span class="tvdb-meta">
                                @(Model.DigestOn
                                    ? $"Sent on {Model.DigestDay}s, when there is something new."
                                    : $"A {Model.DigestDay} summary of new episodes, new seasons and what airs next.")
                            </span>
                        </span>
                        <button type="submit" class="btn btn-outline-dark btn-sm" id="digestSwitch">
                            @(Model.DigestOn ? "Turn off" : "Turn on")
                        </button>
                    </form>
                </dd>
            }
        </dl>

        <div class="tvdb-quiet-actions">
            <form method="post" asp-page="/Account/Logout">
                <button type="submit" class="tvdb-quiet-action">
                    <i class="@Icons.SignOut" aria-hidden="true"></i> Sign out
                </button>
            </form>
            <a asp-page="/Account/Delete" class="tvdb-quiet-action tvdb-quiet-action--danger">
                <i class="@Icons.Delete" aria-hidden="true"></i> Delete my account
            </a>
        </div>
    </section>
</div>

@section Scripts {
    @if (Model.PushAvailable)
    {
        <script src="~/js/tvdb-push.js" asp-append-version="true"></script>
    }
}
