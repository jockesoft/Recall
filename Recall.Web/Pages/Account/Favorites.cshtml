@page
@using Recall.Web.Domain.TheTvDb
@using Recall.Web.Pages.Shared
@model Recall.Web.Pages.Account.FavoritesModel
@{
    ViewData["Title"] = "Favorites";

    var hasSeries = Model.Titles.Any(t => t.Type == SearchResultType.Series);
    var hasMovies = Model.Titles.Any(t => t.Type == SearchResultType.Movie);
    var showFilters = hasSeries && hasMovies;
}

@functions {
    static SeriesCardModel ToCardModel(Recall.Web.Services.Favorites.Models.FavoriteTitle title) => new()
    {
        TvdbId = title.TvdbId,
        Name = title.Name,
        ImageUrl = title.ImageUrl,
        FirstAired = title.FirstAired,
        WatchedEpisodes = title.WatchedEpisodes,
        ReleasedEpisodes = title.ReleasedEpisodes,
        DetailsPage = title.Type == SearchResultType.Movie ? "/Movies/Details" : "/Series/Details",
        IsMovie = title.Type == SearchResultType.Movie,
        LikeHandler = title.Type == SearchResultType.Movie ? "ToggleMovieLike" : "ToggleSeriesLike",
        LikeTargetNoun = title.Type == SearchResultType.Movie ? "movie" : "series",
        ShowLike = true,
        IsLiked = true
    };
}

<div class="tvdb-shell">
    <a asp-page="/Account/Profile" class="tvdb-back-link"><i class="@Icons.Back" aria-hidden="true"></i> Back to profile</a>

    <h1 class="mb-4">Favorites</h1>

    @if (Model.Titles.Count == 0 && Model.Episodes.Count == 0)
    {
        <partial name="_EmptyState" model="@(new EmptyStateModel
                 {
                     Icon = Icons.Like,
                     Heading = "No favorites yet",
                     Text = "Tap the heart on a series, a movie or an episode and it is saved here.",
                     ActionText = "Find series or movies",
                     ActionPage = "/Search",
                     SecondaryActionText = "Go to your library",
                     SecondaryActionPage = "/Library"
                 })" />
    }
    else
    {
        <section class="mb-5">
            <h2 class="tvdb-section-title">Titles <span class="tvdb-count">@Model.Titles.Count</span></h2>

            @if (Model.Titles.Count == 0)
            {
                <partial name="_EmptyState" model="@(new EmptyStateModel
                         {
                             Icon = Icons.Like,
                             Heading = "No liked titles",
                             Text = "Tap the heart on a series or a movie and it shows up here.",
                             HeadingLevel = 3,
                             Inline = true,
                             ActionText = "Find series or movies",
                             ActionPage = "/Search",
                             SecondaryActionText = "Go to your library",
                             SecondaryActionPage = "/Library"
                         })" />
            }
            else
            {
                @if (showFilters)
                {
                    <div class="mb-3">
                        <partial name="_TypeFilterBar" model="showFilters" />
                    </div>
                }

                <div data-library-section>
                    <div class="tvdb-series-grid">
                        @foreach (var title in Model.Titles)
                        {
                            <partial name="_SeriesCard" model="@ToCardModel(title)" />
                        }
                    </div>
                </div>

                <p id="tvdb-library-empty-filter" class="tvdb-meta" role="status" hidden>
                    Nothing matches this filter.
                </p>
            }
        </section>

        <section>
            <h2 class="tvdb-section-title">Episodes <span class="tvdb-count">@Model.Episodes.Count</span></h2>

            @if (Model.Episodes.Count == 0)
            {
                <partial name="_EmptyState" model="@(new EmptyStateModel
                         {
                             Icon = Icons.Like,
                             Heading = "No liked episodes",
                             Text = "Open an episode of a series you follow and tap its heart.",
                             HeadingLevel = 3,
                             Inline = true,
                             ActionText = "Go to your library",
                             ActionPage = "/Library",
                             SecondaryActionText = "Find series or movies",
                             SecondaryActionPage = "/Search"
                         })" />
            }
            else
            {
                <div class="tvdb-fav-episode-grid">
                    @foreach (var episode in Model.Episodes)
                    {
                        <partial name="_FavoriteEpisodeCard" model="@(new FavoriteEpisodeCardModel
                                 {
                                     EpisodeTvdbId = episode.TvdbId,
                                     SeriesName = episode.SeriesName,
                                     EpisodeName = episode.EpisodeName,
                                     SeasonNumber = episode.SeasonNumber,
                                     EpisodeNumber = episode.EpisodeNumber,
                                     ImageUrl = episode.ImageUrl,
                                     Aired = episode.Aired,
                                     Today = Model.Today
                                 })" />
                    }
                </div>
            }
        </section>
    }
</div>

@section Scripts {
    <script src="~/js/tvdb-type-filter.js" asp-append-version="true"></script>
}
