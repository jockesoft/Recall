@page
@model Recall.Web.Pages.Account.ImportWatchlistModel
@using Recall.Web.Infrastructure.Persistence.Entities
@{
    ViewData["Title"] = "Import from IMDb";

    var job = Model.LatestJob;
    var isProcessing = job is { Status: WatchlistImportJobStatus.Processing };
    var progressPercent = job is { TotalCount: > 0 }
        ? (int)Math.Round(100.0 * job.ProcessedCount / job.TotalCount)
        : 0;
}

<div class="tvdb-shell tvdb-shell--narrow">
    <a asp-page="/Account/Profile" class="tvdb-back-link"><i class="@Icons.Back" aria-hidden="true"></i> Back to profile</a>

    <h1 class="mb-3">Import from IMDb</h1>

    <p class="tvdb-prose text-muted">
        Export your list from IMDb (<em>Your Lists &rarr; Ratings</em> or <em>Watchlist</em> &rarr; Export)
        and upload the CSV here. Rated titles are marked watched with your rating; unrated movies are added
        to your watchlist, and unrated series are added to your library. Matching against TheTVDB happens
        gradually in the background, a few rows a minute, so a large import can take a while to finish.
    </p>

    @if (isProcessing)
    {
        <section class="mb-4">
            <div class="d-flex justify-content-between align-items-baseline mb-1">
                <span class="tvdb-eyebrow">Importing @job!.FileName</span>
                <span class="tvdb-mono">@job!.ProcessedCount / @job!.TotalCount</span>
            </div>
            <div class="progress" role="progressbar" aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width:@(progressPercent)%"></div>
            </div>
            <p class="tvdb-meta mt-2 mb-0">
                Refresh this page to check progress — it updates every minute or so.
            </p>
        </section>
    }
    else
    {
        <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="mb-4">
            <div class="mb-3">
                <label for="file" class="form-label">CSV file</label>
                <input type="file" id="file" name="file" accept=".csv" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary">Start import</button>
        </form>
    }

    @if (job is not null)
    {
        <section class="mb-4">
            <h2>@(isProcessing ? "Progress so far" : "Last import")</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4">File</dt>
                <dd class="col-sm-8">@job.FileName</dd>

                <dt class="col-sm-4">Imported</dt>
                <dd class="col-sm-8"><span class="tvdb-mono">@job.ImportedCount</span></dd>

                <dt class="col-sm-4">Already had it</dt>
                <dd class="col-sm-8"><span class="tvdb-mono">@job.SkippedCount</span></dd>

                <dt class="col-sm-4">No TheTVDB match</dt>
                <dd class="col-sm-8"><span class="tvdb-mono">@job.NotFoundCount</span></dd>

                @if (job.FailedCount > 0)
                {
                    <dt class="col-sm-4">Failed</dt>
                    <dd class="col-sm-8"><span class="tvdb-mono">@job.FailedCount</span></dd>
                }
            </dl>
        </section>

        @if (job.Items.Count > 0)
        {
            <section>
                <h2>Rows</h2>
                <div class="table-responsive" tabindex="0" role="region" aria-label="Imported rows">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Title</th>
                                <th>Type</th>
                                <th>Rating</th>
                                <th>Status</th>
                                <th>Detail</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in job.Items)
                            {
                                <tr>
                                    <td class="tvdb-mono">@item.RowNumber</td>
                                    <td>@item.Title</td>
                                    <td>@item.TitleType</td>
                                    <td class="tvdb-mono">@(item.YourRating?.ToString() ?? "—")</td>
                                    <td>@item.Status</td>
                                    <td>@item.ResultMessage</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>
