@page
@model Recall.Web.Pages.Account.ImportWatchlistModel
@{
    ViewData["Title"] = "Import from IMDb";

    var job = Model.LatestJob;
    var progressPercent = job is { TotalCount: > 0 }
        ? (int)Math.Round(100.0 * job.ProcessedCount / job.TotalCount)
        : 0;
}

<div class="tvdb-shell tvdb-shell--narrow">
    <a asp-page="/Account/Profile" class="tvdb-back-link"><i class="@Icons.Back" aria-hidden="true"></i> Back to profile</a>

    <h1 class="mb-3">Import from IMDb</h1>

    <ol class="tvdb-steps mb-3">
        <li>On IMDb, open <em>Your ratings</em> or <em>Your watchlist</em> and choose <em>Export</em>.</li>
        <li>Upload the CSV file here.</li>
        <li>Matching against TheTVDB runs in the background, a few rows a minute.</li>
    </ol>
    <p class="tvdb-meta mb-4">
        Rated titles are marked watched with your rating; unrated movies go on your watchlist and unrated series into your library.
    </p>

    @if (Model.IsProcessing)
    {
        <section class="tvdb-import-progress mb-4" aria-label="Import progress">
            <div class="tvdb-eyebrow text-truncate mb-1">Importing @job!.FileName</div>
            <div class="progress" role="progressbar" aria-label="Rows matched"
                 aria-valuenow="@job.ProcessedCount" aria-valuemin="0" aria-valuemax="@job.TotalCount"
                 aria-valuetext="@job.ProcessedCount of @job.TotalCount rows matched">
                <div class="progress-bar" style="width:@(progressPercent)%"></div>
            </div>
            <p class="mt-2 mb-1"><span class="tvdb-mono">@job.ProcessedCount</span> of <span class="tvdb-mono">@job.TotalCount</span> rows matched</p>
            <p class="tvdb-meta mb-0">
                This page refreshes every @ImportWatchlistModel.RefreshSeconds seconds until the import is done.
            </p>
        </section>
    }
    else
    {
        <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="mb-4">
            <div class="mb-3">
                <label for="file" class="form-label">CSV file</label>
                <input type="file" id="file" name="file" accept=".csv" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="@Icons.Upload me-1" aria-hidden="true"></i>Start import
            </button>
        </form>
    }

    @if (job is not null)
    {
        <section class="mb-4">
            <h2>@(Model.IsProcessing ? "So far" : "Last import")</h2>
            <p class="tvdb-meta mb-2">@job.FileName, @DisplayDate.Format(job.CreatedUtc, Model.Today)</p>

            <ul class="tvdb-import-summary list-unstyled">
                @foreach (var outcome in Model.Summary)
                {
                    <li class="tvdb-badge @outcome.Display.BadgeClass @(outcome.Count == 0 ? "is-zero" : null)">
                        <i class="@outcome.Display.Icon" aria-hidden="true"></i>
                        <span class="tvdb-mono">@outcome.Count</span> @outcome.Display.Label
                    </li>
                }
            </ul>
        </section>

        @if (job.Items.Count > 0)
        {
            <section>
                <h2>Rows <span class="tvdb-count">@job.Items.Count</span></h2>
                <ul class="list-group tvdb-import-list">
                    @foreach (var item in job.Items)
                    {
                        var display = ImportStatusDisplay.For(item.Status);
                        var detailsPage = ImportWatchlistModel.DetailsPage(item);

                        <li class="list-group-item tvdb-import-row">
                            <div class="tvdb-import-row__main">
                                @if (detailsPage is not null)
                                {
                                    <a asp-page="@detailsPage" asp-route-id="@item.ResolvedTvdbId" class="tvdb-import-row__title tvdb-link-plain">@item.Title</a>
                                }
                                else
                                {
                                    <span class="tvdb-import-row__title">@item.Title</span>
                                }
                                <span class="tvdb-meta">@ImportWatchlistModel.MetaLine(item)</span>
                                @if (!string.IsNullOrWhiteSpace(item.ResultMessage))
                                {
                                    <span class="tvdb-import-row__detail">@item.ResultMessage</span>
                                }
                            </div>
                            <span class="tvdb-badge @display.BadgeClass">
                                <i class="@display.Icon" aria-hidden="true"></i> @display.Label
                            </span>
                        </li>
                    }
                </ul>
            </section>
        }
    }
</div>

@section Scripts {
    @if (Model.IsProcessing)
    {
        <script>
            // Matching runs in a background job; reload to show how far it has got.
            setTimeout(function () { window.location.reload(); }, @(ImportWatchlistModel.RefreshSeconds * 1000));
        </script>
    }
}
