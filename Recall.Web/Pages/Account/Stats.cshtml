@page
@using Recall.Web.Pages.Shared
@using Recall.Web.Services.Stats
@model Recall.Web.Pages.Account.StatsModel
@{
    ViewData["Title"] = "Your stats";

    var stats = Model.Stats;
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="tvdb-shell">
    <a asp-page="/Account/Profile" class="tvdb-back-link"><i class="@Icons.Back" aria-hidden="true"></i> Back to profile</a>

    @if (Model.LoadFailed)
    {
        <partial name="_EmptyState" model="@(new EmptyStateModel
                 {
                     Icon = Icons.Problem,
                     Heading = "Your stats couldn't be loaded",
                     Text = "Something went wrong on our side. Nothing is lost; please try again in a moment.",
                     HeadingLevel = 1,
                     ActionText = "Back to profile",
                     ActionPage = "/Account/Profile"
                 })" />
    }
    else if (stats.IsEmpty)
    {
        <h1 class="mb-4">Your stats</h1>

        <partial name="_EmptyState" model="@(new EmptyStateModel
                 {
                     Icon = Icons.Stats,
                     Heading = "No stats yet",
                     Text = "Mark episodes and movies as watched, and your watch time, your most watched series and your genres show up here.",
                     ActionText = "Find something to watch",
                     ActionPage = "/Search",
                     SecondaryActionText = "Import from IMDb",
                     SecondaryActionPage = "/Account/ImportWatchlist"
                 })" />
    }
    else
    {
        <h1 class="mb-2">Your stats</h1>
        <p class="tvdb-meta mb-4" id="statsLead">@Model.Lead</p>

        @* ---- Totals: every watch, whatever its source ---- *@
        <ul class="tvdb-stat-row tvdb-stat-row--four list-unstyled tvdb-page-section" id="statsTotals">
            <li>
                <div class="tvdb-stat-item">
                    <span class="tvdb-stat-item__value">@StatsFormat.Duration(stats.Totals.Minutes)</span>
                    <span class="tvdb-stat-item__label">Watch time</span>
                </div>
            </li>
            <li>
                <div class="tvdb-stat-item">
                    <span class="tvdb-stat-item__value">@StatsFormat.Number(stats.Totals.Episodes)</span>
                    <span class="tvdb-stat-item__label">@(stats.Totals.Episodes == 1 ? "Episode" : "Episodes")</span>
                </div>
            </li>
            <li>
                <div class="tvdb-stat-item">
                    <span class="tvdb-stat-item__value">@StatsFormat.Number(stats.Totals.Movies)</span>
                    <span class="tvdb-stat-item__label">@(stats.Totals.Movies == 1 ? "Movie" : "Movies")</span>
                </div>
            </li>
            <li>
                <div class="tvdb-stat-item">
                    <span class="tvdb-stat-item__value">@StatsFormat.Number(stats.Totals.SeriesFinished)</span>
                    <span class="tvdb-stat-item__label">Series finished</span>
                </div>
            </li>
        </ul>

        @* ---- Month by month: only watches whose date says when they were watched ---- *@
        <section class="tvdb-page-section" aria-labelledby="statsMonthsHeading">
            <h2 id="statsMonthsHeading">Month by month</h2>

            @if (!stats.HasChart)
            {
                <partial name="_EmptyState" model="@(new EmptyStateModel
                         {
                             Icon = Icons.Stats,
                             Heading = "Nothing to chart yet",
                             Text = Model.NoChartText,
                             HeadingLevel = 3,
                             Inline = true
                         })" />
            }
            else
            {
                <p class="tvdb-meta">Watch time in each of the last twelve months.</p>

                @* The chart is a list: each column carries its month in words for
                   screen readers, and the bar and labels are decoration. *@
                <ol class="tvdb-month-chart list-unstyled" id="statsMonthChart">
                    @for (var i = 0; i < stats.Months.Count; i++)
                    {
                        var month = stats.Months[i];
                        var showYear = i == 0 || month.Month.Month == 1;
                        <li class="tvdb-month-chart__col">
                            <span class="visually-hidden">@StatsModel.MonthText(month)</span>
                            <span class="tvdb-month-chart__plot" aria-hidden="true">
                                <span class="tvdb-month-chart__value tvdb-mono">@StatsFormat.Hours(month.Minutes)</span>
                                <span class="tvdb-month-chart__bar@(month.Episodes + month.Movies == 0 ? " is-empty" : "")"
                                      style="--tvdb-bar: @(Model.MonthBarPercent(month))%"></span>
                            </span>
                            @* One letter and a short year on a phone, "Oct" and "2026" from 576px. *@
                            <span class="tvdb-month-chart__label" aria-hidden="true">
                                <span class="tvdb-month-chart__narrow">@DisplayDate.MonthShort(month.Month)[..1]</span>
                                <span class="tvdb-month-chart__wide">@DisplayDate.MonthShort(month.Month)</span>
                                @if (showYear)
                                {
                                    <span class="tvdb-month-chart__year tvdb-mono">
                                        <span class="tvdb-month-chart__narrow">’@((month.Month.Year % 100).ToString("00"))</span>
                                        <span class="tvdb-month-chart__wide">@month.Month.Year</span>
                                    </span>
                                }
                            </span>
                        </li>
                    }
                </ol>

                @if (stats.Undated.Any)
                {
                    <p class="tvdb-meta" id="statsUndated">
                        Not on this chart: @Model.UndatedText you marked several at once or imported.
                        Their date is when they were marked, not when you watched them, so they count in the totals only.
                    </p>
                }

                <details class="tvdb-disclosure">
                    <summary>Show these figures as a table</summary>
                    <table class="table table-sm tvdb-stats-table">
                        <caption class="visually-hidden">Watch time, episodes and movies in each of the last twelve months</caption>
                        <thead>
                            <tr>
                                <th scope="col">Month</th>
                                <th scope="col" class="text-end">Watch time</th>
                                <th scope="col" class="text-end">Episodes</th>
                                <th scope="col" class="text-end">Movies</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var month in stats.Months.Reverse())
                            {
                                <tr>
                                    <th scope="row">@DisplayDate.Month(month.Month)</th>
                                    <td class="text-end tvdb-mono">@StatsFormat.Duration(month.Minutes)</td>
                                    <td class="text-end tvdb-mono">@StatsFormat.Number(month.Episodes)</td>
                                    <td class="text-end tvdb-mono">@StatsFormat.Number(month.Movies)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </details>
            }
        </section>

        @* ---- Most watched series: every watch ---- *@
        @if (stats.TopSeries.Count > 0)
        {
            var largest = stats.TopSeries.Max(s => s.Minutes);
            var largestEpisodes = stats.TopSeries.Max(s => s.Episodes);
            <section class="tvdb-page-section" aria-labelledby="statsSeriesHeading">
                <h2 id="statsSeriesHeading">Most watched series</h2>
                <ol class="tvdb-bar-list list-unstyled" id="statsTopSeries">
                    @foreach (var row in stats.TopSeries)
                    {
                        var percent = largest > 0
                            ? StatsFormat.Percent(row.Minutes, largest)
                            : StatsFormat.Percent(row.Episodes, largestEpisodes);
                        <li class="tvdb-bar-list__row">
                            <span class="tvdb-bar-list__head">
                                <a asp-page="/Series/Details" asp-route-id="@row.TvdbId" class="tvdb-bar-list__name tvdb-link-plain">@row.Name</a>
                                <span class="tvdb-bar-list__value tvdb-mono">
                                    @if (row.Minutes > 0)
                                    {
                                        @StatsFormat.Duration(row.Minutes)<text> · </text>
                                    }
                                    @StatsFormat.Count(row.Episodes, "episode")
                                </span>
                            </span>
                            <span class="tvdb-bar-list__track" aria-hidden="true">
                                <span class="tvdb-bar-list__fill" style="--tvdb-bar: @(percent)%"></span>
                            </span>
                        </li>
                    }
                </ol>
            </section>
        }

        @* ---- Genres: every watch; a title counts in full under each of its genres ---- *@
        @if (stats.TopGenres.Count > 0)
        {
            var largest = stats.TopGenres.Max(g => g.Minutes);
            <section class="tvdb-page-section" aria-labelledby="statsGenresHeading">
                <h2 id="statsGenresHeading">Genres</h2>
                <ol class="tvdb-bar-list list-unstyled" id="statsTopGenres">
                    @foreach (var row in stats.TopGenres)
                    {
                        <li class="tvdb-bar-list__row">
                            <span class="tvdb-bar-list__head">
                                <span class="tvdb-bar-list__name">@row.Name</span>
                                <span class="tvdb-bar-list__value tvdb-mono">
                                    @StatsFormat.Duration(row.Minutes) · @StatsFormat.Count(row.Titles, "title")
                                </span>
                            </span>
                            <span class="tvdb-bar-list__track" aria-hidden="true">
                                <span class="tvdb-bar-list__fill" style="--tvdb-bar: @(StatsFormat.Percent(row.Minutes, largest))%"></span>
                            </span>
                        </li>
                    }
                </ol>
                <p class="tvdb-meta mb-0">
                    A title counts in full under each of its genres, so these add up to more than your total.
                    @if (!stats.GenreCoverage.IsComplete)
                    {
                        <span id="statsGenreCoverage">
                            Based on @StatsFormat.Number(stats.GenreCoverage.TitlesWithGenres) of
                            @StatsFormat.Count(stats.GenreCoverage.Titles, "title"); the rest have no genres loaded yet.
                        </span>
                    }
                </p>
            </section>
        }

        @* ---- Ratings ---- *@
        <section class="tvdb-page-section" aria-labelledby="statsRatingsHeading">
            <h2 id="statsRatingsHeading">Your ratings</h2>

            @if (stats.Ratings.Count == 0)
            {
                <partial name="_EmptyState" model="@(new EmptyStateModel
                         {
                             Icon = Icons.Star,
                             Heading = "No ratings yet",
                             Text = "Rate a series, an episode or a movie from 1 to 10 and the spread of your ratings shows up here.",
                             HeadingLevel = 3,
                             Inline = true
                         })" />
            }
            else
            {
                <p class="tvdb-meta" id="statsRatingAverage">
                    Average <span class="tvdb-mono">@(stats.Ratings.Average?.ToString("0.0", invariant))</span>
                    across @StatsFormat.Count(stats.Ratings.Count, "rating").
                </p>
                <ol class="tvdb-bar-list tvdb-bar-list--ratings list-unstyled" id="statsRatings">
                    @for (var value = 10; value >= 1; value--)
                    {
                        var count = stats.Ratings.CountByValue[value - 1];
                        <li class="tvdb-bar-list__row">
                            <span class="visually-hidden">Rated @value: @StatsFormat.Count(count, "title")</span>
                            <span class="tvdb-bar-list__key tvdb-mono" aria-hidden="true">@value</span>
                            <span class="tvdb-bar-list__track" aria-hidden="true">
                                <span class="tvdb-bar-list__fill" style="--tvdb-bar: @(StatsFormat.Percent(count, stats.Ratings.LargestCount))%"></span>
                            </span>
                            <span class="tvdb-bar-list__tally tvdb-mono" aria-hidden="true">@StatsFormat.Number(count)</span>
                        </li>
                    }
                </ol>
            }
        </section>

        @if (Model.GapsText is { } gaps)
        {
            <p class="tvdb-meta mb-0" id="statsGaps">@gaps</p>
        }
    }
</div>
