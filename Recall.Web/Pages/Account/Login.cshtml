@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="tvdb-shell">
    <div class="row justify-content-center">
        <div class="col-sm-10 col-md-8 col-lg-6">
            <h1 class="tvdb-display mb-3">Sign in to Recall.nu</h1>

            @if (Model.LinkSent)
            {
                <div class="alert alert-success" role="alert">
                    If <strong>@Model.Email</strong> has an account, a sign-in link is on its way.
                    Open the email and click the link to finish signing in. The link expires shortly
                    and can only be used once.
                </div>
                <a class="btn btn-link px-0" asp-page="/Account/Login">Use a different email</a>
            }
            else
            {
                <p class="tvdb-prose text-muted">
                    Welcome to Recall.nu! Track your favorite TV shows and movies, and get notified when new episodes are available.<br /><br />
                    Enter your email and we'll send you a link to sign in — no password needed.
                </p>

                <form method="post">
                    <input type="hidden" asp-for="ReturnUrl" />

                    @* Honeypot: off-screen, not announced to AT, skipped by keyboard.
                       Real users never fill it; bots often do. *@
                    <div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true">
                        <label for="Website">Website</label>
                        <input asp-for="Website" autocomplete="off" tabindex="-1" />
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" autocomplete="email" autofocus
                               placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Send sign-in link</button>
                </form>
                <br />
                <p class="tvdb-prose text-muted">Track your favorite shows - Stay up to date - Never miss an episode</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
