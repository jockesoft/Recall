@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-3">Sign in</h1>

        @if (Model.LinkSent)
        {
            <div class="alert alert-success" role="alert">
                If <strong>@Model.Email</strong> has an account, a sign-in link is on its way.
                Open the email and click the link to finish signing in. The link expires shortly
                and can only be used once.
            </div>
            <a class="btn btn-link px-0" asp-page="/Account/Login">Use a different email</a>
        }
        else
        {
            <p class="text-muted">
                Enter your email and we'll send you a link to sign in — no password needed.
            </p>

            <form method="post">
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" autocomplete="email" autofocus
                           placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Send sign-in link</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
