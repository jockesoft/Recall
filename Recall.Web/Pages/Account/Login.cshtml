@page
@model LoginModel
@{
    ViewData["Title"] = "Sign In - Free TV Show & Episode Tracker";
    ViewData["Description"] = "Sign in to Recall.nu, a free TV show tracker. Track every series "
        + "you watch, get notified the moment a new episode airs, and build your list of "
        + "favorites — no password needed.";
    ViewData["Robots"] = "index, follow";
}

<div class="tvdb-shell tvdb-shell--narrow">
    <h1 class="mb-3">Sign in to Recall.nu</h1>

    @if (Model.LinkSent)
    {
        <div class="alert alert-success" role="alert">
            If <strong>@Model.Email</strong> has an account, a sign-in link is on its way.
            Open the email and click the link to finish signing in. The link expires shortly
            and can only be used once.
        </div>
        <a class="btn btn-link px-0" asp-page="/Account/Login">Use a different email</a>
    }
    else
    {
        <p class="tvdb-prose text-muted">
            No account yet? No separate sign-up required — enter your email below and
            we'll send you a secure sign-in link. If it's your first time, an account is
            created for you automatically. Completely free, and all you need is a valid
            email address — no password to remember.
        </p>

        <ul class="list-unstyled tvdb-prose text-muted mb-4">
            <li class="mb-1"><i class="@Icons.Track tvdb-icon--fw me-2" aria-hidden="true"></i>Track every show you're watching in one place</li>
            <li class="mb-1"><i class="@Icons.Bell tvdb-icon--fw me-2" aria-hidden="true"></i>Get notified the moment a new episode airs</li>
            <li class="mb-1"><i class="@Icons.Like tvdb-icon--fw me-2" aria-hidden="true"></i>Like shows and build up your list of favorites</li>
            <li class="mb-1"><i class="@Icons.Secure tvdb-icon--fw me-2" aria-hidden="true"></i>No password to manage — just a secure link sent to your inbox</li>
        </ul>

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="FormRenderedAtUtc" />

            @* Honeypot: off-screen, not announced to AT, skipped by keyboard.
               Real users never fill it; bots often do. *@
            <div class="tvdb-honeypot" aria-hidden="true">
                <label for="Website">Website</label>
                <input asp-for="Website" autocomplete="off" tabindex="-1" />
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" autocomplete="email" autofocus
                       placeholder="you@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            @if (Model.TurnstileEnabled)
            {
                <div class="cf-turnstile mb-3" data-sitekey="@Model.TurnstileSiteKey" data-theme="auto"></div>
            }

            <button type="submit" class="btn btn-primary">
                <i class="@Icons.Send me-1" aria-hidden="true"></i> Send sign-in link
            </button>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.TurnstileEnabled)
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
}

@section Head {
    <script type="application/ld+json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebApplication",
        ["name"] = "Recall.nu",
        ["url"] = "https://recall.nu/",
        ["description"] = ViewData["Description"],
        ["applicationCategory"] = "LifestyleApplication",
        ["operatingSystem"] = "Any",
        ["offers"] = new Dictionary<string, object?>
        {
            ["@type"] = "Offer",
            ["price"] = "0",
            ["priceCurrency"] = "USD"
        }
    }))</script>
}
