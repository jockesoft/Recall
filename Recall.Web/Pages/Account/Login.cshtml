@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="tvdb-shell">
    <div class="row justify-content-center">
        <div class="col-sm-10 col-md-8 col-lg-6">
            <h1 class="tvdb-display mb-3">Sign in to Recall.nu</h1>

            @if (Model.LinkSent)
            {
                <div class="alert alert-success" role="alert">
                    If <strong>@Model.Email</strong> has an account, a sign-in link is on its way.
                    Open the email and click the link to finish signing in. The link expires shortly
                    and can only be used once.
                </div>
                <a class="btn btn-link px-0" asp-page="/Account/Login">Use a different email</a>
            }
            else
            {
                <p class="tvdb-prose text-muted">
                    No account yet? No separate sign-up required — enter your email below and
                    we'll send you a secure sign-in link. If it's your first time, an account is
                    created for you automatically. Completely free, and all you need is a valid
                    email address — no password to remember.
                </p>

                <ul class="list-unstyled tvdb-prose text-muted mb-4">
                    <li class="mb-1"><i class="fa-solid fa-list-check me-2"></i>Track every show you're watching in one place</li>
                    <li class="mb-1"><i class="fa-solid fa-bell me-2"></i>Get notified the moment a new episode airs</li>
                    <li class="mb-1"><i class="fa-solid fa-heart me-2"></i>Like shows and build up your list of favorites</li>
                    <li class="mb-1"><i class="fa-solid fa-shield-halved me-2"></i>No password to manage — just a secure link sent to your inbox</li>
                </ul>

                <form method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <input type="hidden" asp-for="FormRenderedAtUtc" />

                    @* Honeypot: off-screen, not announced to AT, skipped by keyboard.
                       Real users never fill it; bots often do. *@
                    <div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true">
                        <label for="Website">Website</label>
                        <input asp-for="Website" autocomplete="off" tabindex="-1" />
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" autocomplete="email" autofocus
                               placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    @if (Model.TurnstileEnabled)
                    {
                        <div class="cf-turnstile mb-3" data-sitekey="@Model.TurnstileSiteKey" data-theme="auto"></div>
                    }

                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-paper-plane me-1"></i> Send sign-in link
                    </button>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.TurnstileEnabled)
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
}
