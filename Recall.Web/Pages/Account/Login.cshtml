@page
@model LoginModel
@{
    ViewData["Title"] = "Sign In - Free TV Show & Episode Tracker";
    ViewData["Description"] = "Sign in to Recall.nu, a free TV show tracker. Track every series "
        + "you watch, get notified the moment a new episode airs, and build your list of "
        + "favorites — no password needed.";
    ViewData["Robots"] = "index, follow";
}

<div class="tvdb-shell tvdb-shell--narrow">
    @if (Model.LinkSent)
    {
        <div class="tvdb-empty-state">
            <span class="tvdb-empty-state__icon"><i class="@Icons.Mail" aria-hidden="true"></i></span>
            <h1 class="tvdb-empty-state__title">Check your inbox</h1>
            <p class="tvdb-empty-state__text">
                A sign-in link is on its way to <strong class="tvdb-break-anywhere">@Model.Email</strong>.
            </p>
            <p class="tvdb-meta mb-0">
                The link expires in @Model.LinkLifetimeMinutes minute@(Model.LinkLifetimeMinutes == 1 ? "" : "s") and works once.
                Nothing after a few minutes? Check your spam folder.
            </p>
            <div class="tvdb-empty-state__actions">
                <a asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Use a different email</a>
            </div>
        </div>
    }
    else
    {
        <h1 class="mb-2">Sign in</h1>
        <p class="tvdb-prose text-muted mb-4">We'll email you a sign-in link. No password needed.</p>

        <form method="post" class="mb-5">
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="FormRenderedAtUtc" />

            @* Honeypot: off-screen, not announced to AT, skipped by keyboard.
               Real users never fill it; bots often do. *@
            <div class="tvdb-honeypot" aria-hidden="true">
                <label for="Website">Website</label>
                <input asp-for="Website" autocomplete="off" tabindex="-1" />
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" autocomplete="email" autofocus
                       placeholder="you@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            @if (Model.TurnstileEnabled)
            {
                <div class="cf-turnstile mb-3" data-sitekey="@Model.TurnstileSiteKey" data-theme="auto"></div>
            }

            <button type="submit" class="btn btn-primary">
                <i class="@Icons.Send me-1" aria-hidden="true"></i> Send sign-in link
            </button>
        </form>

        <ul class="tvdb-benefits list-unstyled" aria-label="What you get">
            <li><i class="@Icons.Track" aria-hidden="true"></i><span>Track the series and movies you watch in one place.</span></li>
            <li><i class="@Icons.Bell" aria-hidden="true"></i><span>Get notified the day a new episode airs.</span></li>
            <li><i class="@Icons.Secure" aria-hidden="true"></i><span>Free, and new here is fine: your first link creates the account.</span></li>
        </ul>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.TurnstileEnabled)
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
}

@section Head {
    <script type="application/ld+json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebApplication",
        ["name"] = "Recall.nu",
        ["url"] = "https://recall.nu/",
        ["description"] = ViewData["Description"],
        ["applicationCategory"] = "LifestyleApplication",
        ["operatingSystem"] = "Any",
        ["offers"] = new Dictionary<string, object?>
        {
            ["@type"] = "Offer",
            ["price"] = "0",
            ["priceCurrency"] = "USD"
        }
    }))</script>
}
