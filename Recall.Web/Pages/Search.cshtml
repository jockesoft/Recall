@page
@using Recall.Web.Domain.TheTvDb
@model Recall.Web.Pages.SearchModel
@{
    ViewData["Title"] = "Search";

    var hiddenCount = Math.Max(0, Model.Results.Count - SearchModel.InitialResultCount);
}

<div class="tvdb-shell">
    <h1 class="mb-4">Search</h1>

    <form method="get" class="tvdb-search-form tvdb-page-section">
        <label asp-for="Query" class="form-label"></label>
        @* The field takes the width; the button keeps its own. *@
        <div class="tvdb-search-form__row">
            <input asp-for="Query" class="form-control" placeholder="e.g. Dark, Oppenheimer..." aria-describedby="@(Model.HasSearched ? null : "searchHint")" />
            <button type="submit" class="btn btn-primary">
                <i class="@Icons.Search me-1" aria-hidden="true"></i> Search
            </button>
        </div>
        <span asp-validation-for="Query" class="text-danger"></span>
        @if (!Model.HasSearched)
        {
            <div id="searchHint" class="form-text">Search TheTVDB for any series or movie.</div>
        }
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <partial name="_EmptyState" model="@(new EmptyStateModel
                 {
                     Icon = Icons.Problem,
                     Heading = "Search is not available right now",
                     Text = Model.ErrorMessage,
                     Inline = true
                 })" />
    }
    else if (Model.HasSearched && Model.Results.Count == 0 && ViewData.ModelState.IsValid)
    {
        <partial name="_EmptyState" model="@(new EmptyStateModel
                 {
                     Icon = Icons.Search,
                     Heading = "No matches",
                     Text = $"Nothing on TheTVDB matches \u201C{Model.Query}\u201D. Check the spelling or try the original title.",
                     Inline = true
                 })" />
    }

    @if (Model.Results.Count > 0)
    {
        <p class="tvdb-meta" role="status">
            <span class="tvdb-mono">@Model.Results.Count</span> @(Model.Results.Count == 1 ? "result" : "results")
        </p>

        <ul class="list-group tvdb-result-list" id="searchResults">
            @for (var i = 0; i < Model.Results.Count; i++)
            {
                var item = Model.Results[i];
                var isSeries = item.Type == SearchResultType.Series;
                var badge = Model.LibraryBadge(item);
                var meta = string.IsNullOrWhiteSpace(item.Year)
                    ? (isSeries ? "Series" : "Movie")
                    : $"{(isSeries ? "Series" : "Movie")} \u00B7 {item.Year}";

                @* Results past the first page are rendered hidden; "Show more" reveals them. *@
                <li class="list-group-item tvdb-result" hidden="@(i >= SearchModel.InitialResultCount)">
                    <div class="tvdb-thumb @(string.IsNullOrWhiteSpace(item.ImageUrl) ? "is-empty" : "")">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="" class="tvdb-thumb" loading="lazy"/>
                        }
                        else
                        {
                            <span>No image</span>
                        }
                    </div>

                    <div class="tvdb-result__body">
                        <h2 class="tvdb-result__title">
                            @* The title is the link; stretched, it makes the whole row the target. *@
                            <a asp-page="@(isSeries ? "/Series/Details" : "/Movies/Details")" asp-route-id="@item.TvdbId" class="stretched-link">@item.Name</a>
                        </h2>

                        <div class="tvdb-result__meta">
                            <span class="tvdb-meta">@meta</span>
                            @if (badge is not null)
                            {
                                <span class="tvdb-badge tvdb-badge--ok"><i class="@Icons.Check" aria-hidden="true"></i> @badge</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.Overview))
                        {
                            <p class="tvdb-result__overview" lang="@item.OverviewLanguage">@item.Overview</p>
                        }
                    </div>
                </li>
            }
        </ul>

        @if (hiddenCount > 0)
        {
            <div class="tvdb-show-more">
                <button type="button" class="btn btn-outline-dark" id="showMoreResults" aria-controls="searchResults"
                        data-page-size="@SearchModel.InitialResultCount">
                    Show <span class="tvdb-mono" id="showMoreCount">@Math.Min(hiddenCount, SearchModel.InitialResultCount)</span> more
                </button>
            </div>
        }
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (hiddenCount > 0)
    {
        <script>
            // The rest of the results are already on the page: reveal the next
            // batch and put focus on its first result, so keyboard users carry
            // on from there. The button goes away with the last batch.
            (function () {
                var button = document.getElementById('showMoreResults');
                var count = document.getElementById('showMoreCount');
                if (!button || !count) return;

                var pageSize = parseInt(button.dataset.pageSize, 10) || 20;

                button.addEventListener('click', function () {
                    var hidden = Array.prototype.slice.call(document.querySelectorAll('#searchResults > li[hidden]'));
                    var batch = hidden.slice(0, pageSize);
                    batch.forEach(function (item) { item.hidden = false; });

                    var left = hidden.length - batch.length;
                    if (left > 0) {
                        count.textContent = Math.min(left, pageSize);
                    } else {
                        button.parentElement.remove();
                    }

                    var first = batch.length > 0 ? batch[0].querySelector('a') : null;
                    if (first) first.focus();
                });
            })();
        </script>
    }
}
