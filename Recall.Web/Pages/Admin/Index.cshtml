@page
@model Recall.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin";
}

<div class="tvdb-shell tvdb-shell--narrow">
    <h1 class="mb-2">Admin</h1>
    <p class="tvdb-prose text-muted mb-4">
        Who has an account on Recall.nu. Roles are changed directly in the database; every new
        account starts as <strong>User</strong>.
    </p>

    <ul class="tvdb-stat-row list-unstyled mb-0">
        <li>
            <div class="tvdb-stat-item">
                <span class="tvdb-stat-item__value">@Model.RegisteredUserCount.ToString("N0")</span>
                <span class="tvdb-stat-item__label">Registered @(Model.RegisteredUserCount == 1 ? "user" : "users")</span>
            </div>
        </li>
        <li>
            <div class="tvdb-stat-item">
                <span class="tvdb-stat-item__value">@Model.AdminCount.ToString("N0")</span>
                <span class="tvdb-stat-item__label">@(Model.AdminCount == 1 ? "Admin" : "Admins")</span>
            </div>
        </li>
    </ul>
</div>
