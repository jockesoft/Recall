@page "{id:int}"
@model Recall.Web.Pages.Series.DetailsModel
@functions {
    static string Truncate(string text, int maxLength) =>
        text.Length <= maxLength ? text : text[..maxLength].TrimEnd() + "…";
}
@{
    ViewData["Title"] = Model.Series is null ? "Series Details" : Model.Series.Name;
    ViewData["Description"] = !string.IsNullOrWhiteSpace(Model.Series?.Overview)
        ? Truncate(Model.Series.Overview, 300)
        : $"Details, cast, and ratings for {(Model.Series?.Name ?? "this series")} on Recall.nu.";
    ViewData["Robots"] = Model.Series is not null ? "index, follow" : "noindex, nofollow";
}

@Html.AntiForgeryToken()

@if (Model.Series is null || Model.Aggregate is null)
{
    <div class="tvdb-shell">
        <a asp-page="/Search" class="tvdb-back-link"
           onclick="if (history.length > 1) { event.preventDefault(); history.back(); }"><i class="@Icons.Back" aria-hidden="true"></i> Back</a>

        <partial name="_EmptyState" model="@(new EmptyStateModel
                 {
                     Icon = Icons.Problem,
                     Heading = "This series couldn't be loaded",
                     Text = "TheTVDB, where the series information comes from, isn't answering right now. Please try again in a little while.",
                     HeadingLevel = 1,
                     ActionText = "Search for a series",
                     ActionPage = "/Search"
                 })" />
    </div>
}
else
{
    var series = Model.Aggregate;
    var today = Model.Today;
    var signedIn = Model.IsAuthenticated;
    var earlierOpen = Model.Seasons.Any(s => s.IsEarlier && s.IsOpen);

    <partial name="_TitleHero" model="@Model.BuildHero()" />

    <div class="tvdb-shell tvdb-shell--below-hero">
        @* Anchors, not tabs: everything stays on the page. *@
        <nav class="tvdb-section-links" aria-label="Sections">
            <ul class="tvdb-section-links__list list-unstyled">
                @if (Model.Seasons.Count > 0)
                {
                    <li><a href="#episodes">Episodes</a></li>
                }
                <li><a href="#overview">Overview</a></li>
                @if (Model.Cast.Count > 0 || Model.Crew.Count > 0)
                {
                    <li><a href="#cast">Cast</a></li>
                }
            </ul>
            @if (Model.NextEpisodeId is { } nextId)
            {
                <a href="#@SeasonCards.EpisodeAnchor(nextId)" class="tvdb-section-links__next" data-jump-to-next>
                    Jump to next <i class="@Icons.Expand" aria-hidden="true"></i>
                </a>
            }
        </nav>

        <div class="tvdb-detail-layout">
            <div class="tvdb-detail-layout__main">
                @if (Model.Seasons.Count > 0)
                {
                    <section id="episodes" class="tvdb-detail-section" aria-labelledby="episodesHeading">
                        <div class="tvdb-detail-section__head">
                            <h2 id="episodesHeading">Episodes</h2>
                            @if (Model.EpisodesSummary is not null)
                            {
                                <p class="tvdb-detail-section__figures tvdb-mono">@Model.EpisodesSummary</p>
                            }
                        </div>

                        @if (Model.EarlierSeasonCount > 0)
                        {
                            <details class="tvdb-earlier-seasons" open="@earlierOpen">
                                <summary class="tvdb-earlier-seasons__toggle">
                                    <i class="@Icons.Expand" aria-hidden="true"></i>
                                    <span class="tvdb-earlier-seasons__show">Show @Model.EarlierSeasonCount earlier season@(Model.EarlierSeasonCount == 1 ? "" : "s")</span>
                                    <span class="tvdb-earlier-seasons__hide">Hide earlier seasons</span>
                                </summary>
                                <div class="tvdb-season-cards">
                                    @foreach (var season in Model.Seasons.Where(s => s.IsEarlier))
                                    {
                                        <partial name="_SeasonCard" model="@(new SeasonCardView(season, series.TvdbId, signedIn))" />
                                    }
                                </div>
                            </details>
                        }

                        <div class="tvdb-season-cards">
                            @foreach (var season in Model.Seasons.Where(s => !s.IsEarlier))
                            {
                                <partial name="_SeasonCard" model="@(new SeasonCardView(season, series.TvdbId, signedIn))" />
                            }
                        </div>
                    </section>
                }
            </div>

            <div class="tvdb-detail-layout__side">
                <section id="overview" class="tvdb-detail-section" aria-labelledby="overviewHeading">
                    <h2 id="overviewHeading">Overview</h2>
                    @if (!string.IsNullOrWhiteSpace(series.Overview))
                    {
                        <p class="tvdb-prose">@series.Overview</p>
                    }

                    <dl class="tvdb-fact-list">
                        @if (series.FirstAired is { } firstAired)
                        {
                            <div>
                                <dt>First aired</dt>
                                <dd>@DisplayDate.Format(firstAired, today)</dd>
                            </div>
                        }
                        @if (Model.Network is { } network)
                        {
                            <div>
                                <dt>Network</dt>
                                <dd>@network</dd>
                            </div>
                        }
                        @if (Model.NextRelease is { } next)
                        {
                            <div>
                                <dt>Next episode</dt>
                                <dd><span class="tvdb-mono">@next.Episode.SlateCode()</span> · @DisplayDate.Format(next.Release.AirDate, today)</dd>
                            </div>
                        }
                        @if (Model.ImdbRating is { } imdb)
                        {
                            <div>
                                <dt>IMDb</dt>
                                <dd>
                                    <i class="@Icons.Star tvdb-rating-star" aria-hidden="true"></i>
                                    <span class="tvdb-mono">@imdb</span>&#8202;/&#8202;10
                                    @if (Model.ImdbVotes is { } votes)
                                    {
                                        <span class="tvdb-meta">· @votes votes</span>
                                    }
                                </dd>
                            </div>
                        }
                    </dl>

                    @if (Model.OmdbAwards is { } awards)
                    {
                        <div class="tvdb-awards">
                            <i class="@Icons.Award" aria-hidden="true"></i>
                            <div>
                                <p class="mb-0">@awards</p>
                                <span class="tvdb-awards-src">via OMDb</span>
                            </div>
                        </div>
                    }
                </section>

                @if (Model.Cast.Count > 0 || Model.Crew.Count > 0)
                {
                    <div id="cast" class="tvdb-detail-people">
                        <partial name="_CastList" model="@(new CastListModel { Heading = "Cast", Id = "castList", People = Model.Cast, Column = true, ShowAllLabel = "Show all cast" })" />
                        <partial name="_CastList" model="@(new CastListModel { Heading = "Crew", Id = "crewList", People = Model.Crew, Column = true })" />
                    </div>
                }

                <p class="tvdb-source-line">
                    <a class="tvdb-metalink" href="https://www.thetvdb.com/series/@series.Slug" target="_blank" rel="noopener">TheTVDB <span class="tvdb-mono">@series.TvdbId</span></a>
                    @if (Model.Series.ImdbId is not null)
                    {
                        <a class="tvdb-metalink" href="https://www.imdb.com/title/@Model.Series.ImdbId" target="_blank" rel="noopener">IMDb <span class="tvdb-mono">@Model.Series.ImdbId</span></a>
                    }
                </p>
            </div>
        </div>
    </div>

    @foreach (var season in Model.Seasons.Where(s => signedIn && s.WatchedCount > 0))
    {
        <partial name="_ConfirmModal" model="@(new ConfirmModalModel
                 {
                     Id = $"unwatch{season.Anchor}",
                     Title = $"Mark {season.Title.ToLowerInvariant()} unwatched?",
                     Text = $"This marks {season.WatchedCount} watched episode{(season.WatchedCount == 1 ? "" : "s")} in {season.Title} as not watched. The dates you watched them on will be lost.",
                     ConfirmLabel = "Mark unwatched",
                     Handler = "MarkSeasonUnwatched",
                     RouteId = series.TvdbId,
                     HiddenFields = { ["Season"] = season.Number.ToString(), ["Anchor"] = season.Anchor }
                 })" />
    }

    @if (signedIn)
    {
        <partial name="_CatchUpModal" model="@(new CatchUpModalModel
                 {
                     RouteId = series.TvdbId,
                     JustThisHandler = "ToggleEpisodeWatched",
                     ThroughHandler = "MarkWatchedThrough",
                     Fields = ["episodeId", "Season", "Anchor"]
                 })" />
    }

    @if (Model.IsTrackedByCurrentUser)
    {
        <partial name="_ConfirmModal" model="@(new ConfirmModalModel
                 {
                     Id = Recall.Web.Pages.Series.DetailsModel.RemoveFromLibraryModalId,
                     Title = "Remove from library?",
                     Text = $"{series.Name} leaves your library and you stop getting notifications for it. Your watch history is kept, and comes back if you add the series again.",
                     ConfirmLabel = "Remove",
                     Handler = "ToggleLibrary",
                     RouteId = series.TvdbId,
                     HiddenFields = { ["Season"] = Model.Season?.ToString() ?? string.Empty }
                 })" />
    }
}

@section Scripts {
    <script src="~/js/tvdb-cast.js" asp-append-version="true"></script>
    <script src="~/js/tvdb-share.js" asp-append-version="true"></script>
    <script src="~/js/tvdb-series.js" asp-append-version="true"></script>
}

@section Head {
    @if (Model.Series is not null)
    {
        <script type="application/ld+json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "TVSeries",
            ["name"] = Model.Series.Name,
            ["description"] = ViewData["Description"],
            ["image"] = Model.Series.ImageUrl,
            ["startDate"] = Model.Series.FirstAired
        }))</script>
    }
}
