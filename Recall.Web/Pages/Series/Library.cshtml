@page
@using Recall.Web.Pages.Shared
@model Recall.Web.Pages.Series.LibraryModel
@{
    ViewData["Title"] = "My Library";
}

<div class="tvdb-shell">
    <h1 class="tvdb-display mb-3">My Library</h1>

    <div class="mb-3">
        <a asp-page="/Series/Search" class="btn btn-primary">Find series</a>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            Your library is empty. Search and save series to get started.
        </div>
    }
    else
    {
        <p class="tvdb-mono text-muted">You have @Model.Items.Count tracked series.</p>

        <div class="tvdb-series-grid">
            @foreach (var item in Model.Items)
            {
                var progress = Model.ProgressByTvdbId.TryGetValue(item.TvdbId, out var p) ? p : default;
                <partial name="_SeriesCard" model="@(new SeriesCardModel
                         {
                             TvdbId = item.TvdbId,
                             Name = item.Name,
                             ImageUrl = item.ImageUrl,
                             FirstAired = item.FirstAired,
                             WatchedEpisodes = progress.WatchedReleased,
                             ReleasedEpisodes = progress.Released
                         })" />
            }
        </div>
    }
</div>
