@page "{id:int}"
@model Recall.Web.Pages.Movies.DetailsModel
@functions {
    static string FormatUsd(decimal value) => "$" + value.ToString("N0", System.Globalization.CultureInfo.InvariantCulture);

    static string Truncate(string text, int maxLength) =>
        text.Length <= maxLength ? text : text[..maxLength].TrimEnd() + "…";
}
@{
    var movie = Model.Movie;
    ViewData["Title"] = movie?.Name ?? "Movie Details";
    ViewData["Description"] = !string.IsNullOrWhiteSpace(movie?.Overview)
        ? Truncate(movie.Overview, 300)
        : $"Details and cast for {(movie?.Name ?? "this movie")} on Recall.nu.";
    ViewData["Robots"] = movie is not null ? "index, follow" : "noindex, nofollow";
}

@Html.AntiForgeryToken()

@if (movie is null)
{
    <div class="tvdb-shell">
        <a asp-page="/Search" class="tvdb-back-link"
           onclick="if (history.length > 1) { event.preventDefault(); history.back(); }"><i class="@Icons.Back" aria-hidden="true"></i> Back</a>

        <partial name="_EmptyState" model="@(new EmptyStateModel
                 {
                     Icon = Icons.Problem,
                     Heading = "This movie couldn't be loaded",
                     Text = "TheTVDB, where the movie information comes from, isn't answering right now. Please try again in a little while.",
                     HeadingLevel = 1,
                     ActionText = "Search for a movie",
                     ActionPage = "/Search"
                 })" />
    </div>
}
else
{
    var today = Model.Today;
    var imdbId = movie.RemoteIds
        .FirstOrDefault(r => string.Equals(r.SourceName, "imdb", StringComparison.OrdinalIgnoreCase))?.Id;
    var hasPeople = Model.Cast.Count > 0 || Model.Crew.Count > 0;

    <partial name="_TitleHero" model="@Model.BuildHero(ViewContext.HttpContext.Request.Path + ViewContext.HttpContext.Request.QueryString)" />

    <div class="tvdb-shell">
        @* Anchors, not tabs: everything stays on the page. *@
        <nav class="tvdb-section-links" aria-label="Sections">
            <ul class="tvdb-section-links__list list-unstyled">
                <li><a href="#overview">Overview</a></li>
                @if (hasPeople)
                {
                    <li><a href="#@(Model.Cast.Count > 0 ? "cast" : "crew")">Cast &amp; crew</a></li>
                }
            </ul>
        </nav>

        @* One column below 992px (overview, cast, crew); from 992px a grid: the
           overview and then the crew on the left, the cast on the right. *@
        <div class="tvdb-movie-layout">
            <section id="overview" class="tvdb-detail-section tvdb-movie-layout__overview" aria-labelledby="overviewHeading">
                <h2 id="overviewHeading">Overview</h2>
                @if (!string.IsNullOrWhiteSpace(movie.Overview))
                {
                    <p class="tvdb-prose">@movie.Overview</p>
                }

                <dl class="tvdb-fact-list">
                    @if (movie.ReleaseDate is { } released)
                    {
                        <div>
                            <dt>Release date</dt>
                            <dd>@DisplayDate.Format(released, today)</dd>
                        </div>
                    }
                    @if (movie.RuntimeMinutes is > 0 and var minutes)
                    {
                        <div>
                            <dt>Runtime</dt>
                            <dd>@TitleSummary.Runtime(minutes)</dd>
                        </div>
                    }
                    @if (movie.Studios.Count > 0)
                    {
                        <div>
                            <dt>Studio</dt>
                            <dd>@string.Join(", ", movie.Studios)</dd>
                        </div>
                    }
                    @if (movie.Budget is { } budget)
                    {
                        <div>
                            <dt>Budget</dt>
                            <dd class="tvdb-mono">@FormatUsd(budget)</dd>
                        </div>
                    }
                    @if (movie.BoxOffice is { } boxOffice)
                    {
                        <div>
                            <dt>Box office</dt>
                            <dd class="tvdb-mono">@FormatUsd(boxOffice)</dd>
                        </div>
                    }
                    @if (Model.ImdbRating is { } imdb)
                    {
                        <div>
                            <dt>IMDb</dt>
                            <dd>
                                <i class="@Icons.Star tvdb-rating-star" aria-hidden="true"></i>
                                <span class="tvdb-mono">@imdb</span>&#8202;/&#8202;10
                                @if (Model.ImdbVotes is { } votes)
                                {
                                    <span class="tvdb-meta">· @votes votes</span>
                                }
                            </dd>
                        </div>
                    }
                </dl>

                @if (Model.OmdbAwards is { } awards)
                {
                    <div class="tvdb-awards">
                        <i class="@Icons.Award" aria-hidden="true"></i>
                        <div>
                            <p class="mb-0">@awards</p>
                            <span class="tvdb-awards-src">via OMDb</span>
                        </div>
                    </div>
                }
            </section>

            @if (Model.Cast.Count > 0)
            {
                <div id="cast" class="tvdb-detail-people tvdb-movie-layout__cast">
                    <partial name="_CastList" model="@(new CastListModel { Heading = "Cast", Id = "castList", People = Model.Cast, Compact = true, Column = true, ShowAllLabel = "Show all cast" })" />
                </div>
            }

            @if (Model.Crew.Count > 0)
            {
                <div id="crew" class="tvdb-detail-people tvdb-movie-layout__crew">
                    <partial name="_CastList" model="@(new CastListModel { Heading = "Crew", Id = "crewList", People = Model.Crew, Compact = true, TwoColumns = true })" />
                </div>
            }
        </div>

        <p class="tvdb-source-line">
            <a class="tvdb-metalink" href="https://www.thetvdb.com/movies/@movie.Slug" target="_blank" rel="noopener">TheTVDB <span class="tvdb-mono">@movie.TvdbId</span></a>
            @if (imdbId is not null)
            {
                <a class="tvdb-metalink" href="https://www.imdb.com/title/@imdbId" target="_blank" rel="noopener">IMDb <span class="tvdb-mono">@imdbId</span></a>
            }
        </p>
    </div>

    @if (Model.IsOnWatchlist)
    {
        <partial name="_ConfirmModal" model="@(new ConfirmModalModel
                 {
                     Id = Recall.Web.Pages.Movies.DetailsModel.RemoveFromWatchlistModalId,
                     Title = "Remove from watchlist?",
                     Text = $"{movie.Name} leaves your watchlist. You can add it again at any time.",
                     ConfirmLabel = "Remove",
                     Handler = "ToggleWatchlist",
                     RouteId = movie.TvdbId
                 })" />
    }
}

@section Scripts {
    <script src="~/js/tvdb-cast.js" asp-append-version="true"></script>
    <script src="~/js/tvdb-share.js" asp-append-version="true"></script>
}

@section Head {
    @if (movie is not null)
    {
        <script type="application/ld+json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "Movie",
            ["name"] = movie.Name,
            ["description"] = ViewData["Description"],
            ["image"] = movie.ImageUrl,
            ["dateCreated"] = movie.ReleaseDate?.ToString("yyyy-MM-dd"),
            ["genre"] = movie.Genres
        }))</script>
    }
}
