@page
@using Recall.Web.Pages.Shared
@model DashboardModel
@{
    ViewData["Title"] = "Dashboard";

    bool IsFinaleType(string? type) =>
        string.Equals(type, "season", StringComparison.OrdinalIgnoreCase)
        || string.Equals(type, "series", StringComparison.OrdinalIgnoreCase);

    string DayGroup(DateOnly aired)
    {
        var today = Model.Today;
        var days = aired.DayNumber - today.DayNumber;
        return days switch
        {
            0 => "Today",
            1 => "Tomorrow",
            <= 7 => "This week",
            _ => "Later"
        };
    }

    var hasLibrary = Model.TrackedSeriesCount > 0;

    // Collapse multiple episodes of the same series airing on the same date
    // (same season) into a single row — e.g. 8 rows of "The Gentlemen S02" on
    // one day become one row reading "S02 · E01-E08".
    var upcomingRows = Model.UpcomingEpisodes
        .GroupBy(e => new { e.SeriesId, e.AiredDate, e.SeasonNumber })
        .Select(g =>
        {
            var ordered = g
                .OrderBy(e => e.EpisodeNumber ?? int.MaxValue)
                .ThenBy(e => e.EpisodeId)
                .ToList();
            var head = ordered[0];
            var numbers = ordered
                .Where(e => e.EpisodeNumber.HasValue)
                .Select(e => e.EpisodeNumber!.Value)
                .ToList();
            return new
            {
                head.SeriesId,
                head.SeriesName,
                head.ImageUrl,
                head.SeasonNumber,
                head.AiredDate,
                head.Release,
                head.SeriesCaughtUp,
                LinkEpisodeId = head.EpisodeId,
                Count = ordered.Count,
                EpisodeFrom = numbers.Count > 0 ? numbers.Min() : (int?)null,
                EpisodeTo = numbers.Count > 0 ? numbers.Max() : (int?)null,
                SingleName = ordered.Count == 1 ? head.Name : null,
                IsPremiere = numbers.Contains(1),
                IsFinale = ordered.Any(e => IsFinaleType(e.FinaleType))
            };
        })
        .ToList();

    var groupedUpcoming = upcomingRows
        // In UTC, by the release moment's date (the air date when no time is known).
        .GroupBy(r => DayGroup(r.Release.GroupDate))
        .OrderBy(g => g.Key switch { "Today" => 0, "Tomorrow" => 1, "This week" => 2, _ => 3 });
}

<div class="tvdb-shell">
    @* The title on the left, the three figures on the right; on a phone the
       figures wrap below as one row of three tiles. *@
    <div class="tvdb-dashboard-head">
        <div>
            <div class="tvdb-eyebrow mb-1">@DisplayDate.Format(Model.Today, Model.Today)</div>
            <h1 class="mb-0">Your channel</h1>
        </div>

        @if (hasLibrary)
        {
            @* Each figure links to the place that explains it. *@
            <ul class="tvdb-stat-row tvdb-dashboard-head__stats list-unstyled">
                @foreach (var stat in Model.Stats)
                {
                    <li>
                        <a href="@(Url.Page(stat.Page, new { section = stat.Section }) + (stat.Fragment is null ? "" : "#" + stat.Fragment))" class="tvdb-stat-item">
                            <span class="tvdb-stat-item__value">@stat.Value</span>
                            @* A phone shows the short label on one line; the full one
                               follows it as hidden text, so the link's name has both
                               ("1 This week, Airing this week") and starts with what is
                               visible. From 576px the full label is the visible one. *@
                            <span class="tvdb-stat-item__label">
                                <span class="tvdb-stat-item__short">@stat.ShortLabel<span class="visually-hidden">, @stat.Label</span></span>
                                <span class="tvdb-stat-item__full">@stat.Label</span>
                            </span>
                        </a>
                    </li>
                }
            </ul>
        }
    </div>

    @if (!hasLibrary)
    {
        <partial name="_EmptyState" model="@(new EmptyStateModel
                 {
                     Icon = Icons.NoSchedule,
                     Heading = "Nothing on your schedule yet",
                     Text = "Add a few shows to your library and this page turns into your personal air-date guide.",
                     ActionText = "Find series to track",
                     ActionPage = "/Search"
                 })" />
    }
    else
    {
        @if (Model.ShowDigestPrompt)
        {
            @* Shown once: either button settles it, and the switch stays in Profile. *@
            <section class="tvdb-offer tvdb-page-section" aria-labelledby="digestOfferHeading">
                <span class="tvdb-offer__icon"><i class="@Icons.Mail" aria-hidden="true"></i></span>
                <div class="tvdb-offer__text">
                    <h2 class="tvdb-offer__title" id="digestOfferHeading">Get a weekly email of what's new?</h2>
                    <p class="tvdb-meta mb-0">
                        A @Model.DigestDay summary of new episodes, new seasons and what airs next. Only when there is something to say.
                    </p>
                </div>
                <div class="tvdb-offer__actions">
                    <form method="post" asp-page-handler="DigestOptIn">
                        <button type="submit" class="btn btn-primary btn-sm" id="digestOptIn">Turn it on</button>
                    </form>
                    <form method="post" asp-page-handler="DigestDismiss">
                        <button type="submit" class="btn btn-outline-dark btn-sm" id="digestDismiss">No thanks</button>
                    </form>
                </div>
            </section>
        }

        @if (Model.CatchUpEpisodes.Count > 0 || Model.DormantSeriesCount > 0)
        {
            <section class="tvdb-page-section" id="continueWatching" aria-labelledby="continueWatchingHeading">
                <div class="tvdb-section-head">
                    <h2 id="continueWatchingHeading">Continue watching</h2>
                    @if (Model.CatchUpEpisodes.Count > 0 && !Model.HasMoreToContinue)
                    {
                        <a asp-page="/Library" asp-route-section="@DashboardModel.LibraryWatchingSection"
                           class="tvdb-section-head__link tvdb-catchup-seeall-link" id="continueWatchingSeeAll">
                            See all in Library <i class="@Icons.Forward" aria-hidden="true"></i>
                        </a>
                    }
                </div>
                @if (Model.CatchUpEpisodes.Count > 0)
                {
                    var cards = Model.CatchUpEpisodes
                        .Select((ep, index) => new CatchUpCardModel
                        {
                            SeriesId = ep.SeriesId,
                            SeriesName = ep.SeriesName,
                            EpisodeId = ep.EpisodeId,
                            SeasonNumber = ep.SeasonNumber,
                            EpisodeNumber = ep.EpisodeNumber,
                            EpisodeName = ep.Name,
                            ImageUrl = ep.ImageUrl,
                            IsUpNext = index == 0,
                            ShowAll = Model.ShowAll
                        })
                        .ToList();

                    @* Both layouts are on the page; the stylesheet shows one. From
                       576px: every series as a card. On a phone: the first as the
                       card (with "Up next"), the rest as compact rows.
                       Every series is rendered; while the list is collapsed the
                       stylesheet shows the first nine (by count, like the cast
                       lists) and "Show all N" reveals the rest in place. Without
                       script the button is a GET to ?all=true. *@
                    <div class="tvdb-catchup @(Model.ShowAll ? "is-expanded" : "")" id="continueWatchingList" data-collapsible data-catchup>
                        <div class="tvdb-catchup-grid" data-collapsible-list>
                            @foreach (var card in cards)
                            {
                                <partial name="_CatchUpCard" model="card" />
                            }
                        </div>

                        @if (cards.Count > 1)
                        {
                            <ul class="tvdb-catchup-rows list-unstyled" aria-label="More to continue" data-collapsible-list>
                                @foreach (var card in cards.Skip(1))
                                {
                                    <partial name="_CatchUpRow" model="card" />
                                }
                            </ul>
                        }
                    </div>

                    @if (Model.HasMoreToContinue)
                    {
                        var showAllLabel = $"Show all {Model.ContinueWatchingTotal}";
                        <form method="get" action="@(Url.Page("/Dashboard"))#continueWatching" class="tvdb-catchup-toggle" data-catchup-toggle-form>
                            @if (!Model.ShowAll)
                            {
                                <input type="hidden" name="all" value="true" />
                            }
                            <button type="submit" class="btn btn-outline-dark" id="continueWatchingToggle"
                                    aria-expanded="@(Model.ShowAll ? "true" : "false")" aria-controls="continueWatchingList"
                                    data-more="@showAllLabel" data-less="Show fewer">
                                @(Model.ShowAll ? "Show fewer" : showAllLabel)
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-page="/Library" asp-route-section="@DashboardModel.LibraryWatchingSection"
                           class="btn btn-outline-dark tvdb-catchup-seeall">See all in Library</a>
                    }
                }
                else
                {
                    <p class="tvdb-meta mb-0">Nothing you have watched recently is waiting.</p>
                }

                @if (Model.DormantSeriesCount > 0)
                {
                    @* Series not touched in a while get no card; they are one click away in the Library. *@
                    <p class="tvdb-dormant-link">
                        <a asp-page="/Library" asp-route-section="dormant">
                            <span class="tvdb-mono">@Model.DormantSeriesCount</span> series you haven't watched in a while
                            <i class="@Icons.Forward" aria-hidden="true"></i>
                        </a>
                    </p>
                }
            </section>
        }

        <h2 id="upcoming" tabindex="-1">Upcoming</h2>

        @if (Model.UpcomingEpisodes.Count == 0)
        {
            <p class="tvdb-meta mb-0">Nothing airing in the next 30 days for the series you track.</p>
        }
        else
        {
            @foreach (var group in groupedUpcoming)
            {
                // "Today" and "Tomorrow" say the date themselves; the later groups span several days.
                var showDate = group.Key is not ("Today" or "Tomorrow");

                <h3 class="tvdb-schedule-day">@group.Key</h3>
                <div class="tvdb-upcoming-list">
                    @foreach (var row in group
                        .OrderBy(r => r.Release.Utc)
                        .ThenBy(r => r.SeriesName)
                        .ThenBy(r => r.SeasonNumber ?? int.MaxValue))
                    {
                        <partial name="_UpcomingEpisodeCard" model="@(new UpcomingEpisodeCardModel
                                 {
                                     SeriesId = row.SeriesId,
                                     SeriesName = row.SeriesName,
                                     LinkEpisodeId = row.LinkEpisodeId,
                                     SeasonNumber = row.SeasonNumber,
                                     EpisodeFrom = row.EpisodeFrom,
                                     EpisodeTo = row.EpisodeTo,
                                     EpisodeName = row.SingleName,
                                     ImageUrl = row.ImageUrl,
                                     AiredDate = row.AiredDate,
                                     Release = row.Release,
                                     Today = Model.Today,
                                     ShowDate = showDate,
                                     IsPremiere = row.IsPremiere,
                                     IsFinale = row.IsFinale,
                                     EpisodeCount = row.Count,
                                     SeriesCaughtUp = row.SeriesCaughtUp
                                 })" />
                    }
                </div>
            }
        }
    }
</div>

@section Scripts {
    <script src="~/js/tvdb-dashboard.js" asp-append-version="true"></script>
}
