@page
@using Recall.Web.Pages.Shared
@model DashboardModel
@{
    ViewData["Title"] = "Dashboard";

    bool IsFinaleType(string? type) =>
        string.Equals(type, "season", StringComparison.OrdinalIgnoreCase)
        || string.Equals(type, "series", StringComparison.OrdinalIgnoreCase);

    string DayGroup(DateOnly aired)
    {
        var today = Model.Today;
        var days = aired.DayNumber - today.DayNumber;
        return days switch
        {
            0 => "Today",
            1 => "Tomorrow",
            <= 7 => "This week",
            _ => "Later"
        };
    }

    var hasLibrary = Model.TrackedSeriesCount > 0;

    // Collapse multiple episodes of the same series airing on the same date
    // (same season) into a single row — e.g. 8 rows of "The Gentlemen S02" on
    // one day become one row reading "S02 · E01-E08".
    var upcomingRows = Model.UpcomingEpisodes
        .GroupBy(e => new { e.SeriesId, e.AiredDate, e.SeasonNumber })
        .Select(g =>
        {
            var ordered = g
                .OrderBy(e => e.EpisodeNumber ?? int.MaxValue)
                .ThenBy(e => e.EpisodeId)
                .ToList();
            var head = ordered[0];
            var numbers = ordered
                .Where(e => e.EpisodeNumber.HasValue)
                .Select(e => e.EpisodeNumber!.Value)
                .ToList();
            return new
            {
                head.SeriesId,
                head.SeriesName,
                head.ImageUrl,
                head.SeasonNumber,
                head.AiredDate,
                head.SeriesCaughtUp,
                LinkEpisodeId = head.EpisodeId,
                Count = ordered.Count,
                EpisodeFrom = numbers.Count > 0 ? numbers.Min() : (int?)null,
                EpisodeTo = numbers.Count > 0 ? numbers.Max() : (int?)null,
                SingleName = ordered.Count == 1 ? head.Name : null,
                IsPremiere = numbers.Contains(1),
                IsFinale = ordered.Any(e => IsFinaleType(e.FinaleType))
            };
        })
        .ToList();

    var groupedUpcoming = upcomingRows
        .GroupBy(r => DayGroup(r.AiredDate))
        .OrderBy(g => g.Key switch { "Today" => 0, "Tomorrow" => 1, "This week" => 2, _ => 3 });
}

<div class="tvdb-shell">
    <div class="tvdb-eyebrow mb-1">@DisplayDate.Format(Model.Today, Model.Today)</div>
    <h1 class="mb-4">Your channel</h1>

    @if (!hasLibrary)
    {
        <partial name="_EmptyState" model="@(new EmptyStateModel
                 {
                     Icon = Icons.NoSchedule,
                     Heading = "Nothing on your schedule yet",
                     Text = "Add a few shows to your library and this page turns into your personal air-date guide.",
                     ActionText = "Find series to track",
                     ActionPage = "/Search"
                 })" />
    }
    else
    {
        @* One compact row, on phones too. Each stat links to the place that explains it. *@
        <ul class="tvdb-stat-row list-unstyled tvdb-page-section">
            <li>
                <a asp-page="/Library" class="tvdb-stat-item">
                    <span class="tvdb-stat-item__value">@Model.TrackedSeriesCount</span>
                    <span class="tvdb-stat-item__label">Tracked series</span>
                </a>
            </li>
            <li>
                <a href="#upcoming" class="tvdb-stat-item">
                    <span class="tvdb-stat-item__value">@Model.UpcomingThisWeekCount</span>
                    <span class="tvdb-stat-item__label">Airing this week</span>
                </a>
            </li>
            <li>
                <a asp-page="/Library" asp-fragment="watching" class="tvdb-stat-item">
                    <span class="tvdb-stat-item__value">@Model.UnwatchedCount</span>
                    <span class="tvdb-stat-item__label">Unwatched episodes</span>
                </a>
            </li>
        </ul>

        @if (Model.CatchUpEpisodes.Count > 0)
        {
            <h2>Continue watching</h2>
            <div class="tvdb-catchup-grid tvdb-page-section">
                @foreach (var ep in Model.CatchUpEpisodes)
                {
                    <partial name="_CatchUpCard" model="@(new CatchUpCardModel
                             {
                                 SeriesId = ep.SeriesId,
                                 SeriesName = ep.SeriesName,
                                 EpisodeId = ep.EpisodeId,
                                 SeasonNumber = ep.SeasonNumber,
                                 EpisodeNumber = ep.EpisodeNumber,
                                 EpisodeName = ep.Name,
                                 ImageUrl = ep.ImageUrl
                             })" />
                }
            </div>
        }

        <h2 id="upcoming" tabindex="-1">Upcoming</h2>

        @if (Model.UpcomingEpisodes.Count == 0)
        {
            <p class="tvdb-meta mb-0">Nothing airing in the next 30 days for the series you track.</p>
        }
        else
        {
            @foreach (var group in groupedUpcoming)
            {
                // "Today" and "Tomorrow" say the date themselves; the later groups span several days.
                var showDate = group.Key is not ("Today" or "Tomorrow");

                <h3 class="tvdb-schedule-day">@group.Key</h3>
                <div class="tvdb-upcoming-list">
                    @foreach (var row in group
                        .OrderBy(r => r.AiredDate)
                        .ThenBy(r => r.SeriesName)
                        .ThenBy(r => r.SeasonNumber ?? int.MaxValue))
                    {
                        <partial name="_UpcomingEpisodeCard" model="@(new UpcomingEpisodeCardModel
                                 {
                                     SeriesId = row.SeriesId,
                                     SeriesName = row.SeriesName,
                                     LinkEpisodeId = row.LinkEpisodeId,
                                     SeasonNumber = row.SeasonNumber,
                                     EpisodeFrom = row.EpisodeFrom,
                                     EpisodeTo = row.EpisodeTo,
                                     EpisodeName = row.SingleName,
                                     ImageUrl = row.ImageUrl,
                                     AiredDate = row.AiredDate,
                                     Today = Model.Today,
                                     ShowDate = showDate,
                                     IsPremiere = row.IsPremiere,
                                     IsFinale = row.IsFinale,
                                     EpisodeCount = row.Count,
                                     SeriesCaughtUp = row.SeriesCaughtUp
                                 })" />
                    }
                </div>
            }
        }
    }
</div>
