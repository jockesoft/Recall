@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="tvdb-shell tvdb-shell--narrow">
    <partial name="_EmptyState" model="@(new EmptyStateModel
             {
                 Icon = Icons.Problem,
                 Heading = "Something went wrong",
                 Text = "Sorry about that. The problem is on our side, and it has been logged. Please try again in a little while.",
                 HeadingLevel = 1,
                 ActionText = "Go to the home page",
                 ActionPage = "/Index"
             })" />

    @if (Model.ShowRequestId)
    {
        <p class="tvdb-error-reference">
            If you contact us about this, mention reference <span class="tvdb-mono">@Model.RequestId</span>
        </p>
    }
</div>
