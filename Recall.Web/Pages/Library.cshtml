@page
@using Recall.Web.Domain.TheTvDb
@using Recall.Web.Pages.Shared
@model Recall.Web.Pages.LibraryModel
@{
    var selected = Model.SelectedSection;
    ViewData["Title"] = selected is null ? "My Library" : $"{selected.Title} - My Library";

    // The All / Series / Movies filter is only offered when there is something to tell apart.
    var shownItems = selected is null ? Model.Sections.SelectMany(s => s.Items) : selected.Items;
    var showFilters = shownItems.Any(i => i.Type == SearchResultType.Series)
                      && shownItems.Any(i => i.Type == SearchResultType.Movie);

    // A like posted from the one-section view comes back to it.
    IDictionary<string, string> likeFields = selected is null
        ? new Dictionary<string, string>()
        : new Dictionary<string, string> { ["Section"] = selected.Slug };
}

@functions {
    static SeriesCardModel ToCardModel(LibraryCardItem item, IDictionary<string, string> likeFields) => new()
    {
        LikeHiddenFields = likeFields,
        TvdbId = item.TvdbId,
        Name = item.Name,
        ImageUrl = item.ImageUrl,
        FirstAired = item.FirstAired,
        WatchedEpisodes = item.WatchedEpisodes,
        ReleasedEpisodes = item.ReleasedEpisodes,
        Caption = item.Caption,
        ProgressText = item.ProgressText,
        DetailsPage = item.Type == SearchResultType.Movie ? "/Movies/Details" : "/Series/Details",
        IsMovie = item.Type == SearchResultType.Movie,
        ShowLike = item.Type == SearchResultType.Series,
        IsLiked = item.IsLiked
    };
}

<div class="tvdb-shell">
    @if (selected is not null)
    {
        @* One section on its own: where "See all N" on a phone leads. *@
        <a asp-page="/Library" asp-fragment="@selected.Slug" class="tvdb-back-link"><i class="@Icons.Back" aria-hidden="true"></i> Back to library</a>

        <h1 class="mb-4">@selected.Title <span class="tvdb-count">@selected.Items.Count</span></h1>

        @if (showFilters)
        {
            <div class="tvdb-filter-row">
                <partial name="_TypeFilterBar" model="showFilters" />
            </div>
        }

        @if (selected.Items.Count == 0)
        {
            <partial name="_EmptyState" model="@(new EmptyStateModel
                     {
                         Icon = Icons.EmptyLibrary,
                         Heading = "Nothing here right now",
                         Text = $"Nothing in your library is under \u201C{selected.Title}\u201D at the moment.",
                         ActionText = "Back to your library",
                         ActionPage = "/Library"
                     })" />
        }
        else
        {
            <div data-library-section>
                <div class="tvdb-series-grid">
                    @foreach (var item in selected.Items)
                    {
                        <partial name="_SeriesCard" model="@ToCardModel(item, likeFields)" />
                    }
                </div>
            </div>

            <p id="tvdb-library-empty-filter" class="tvdb-meta" role="status" hidden>
                Nothing matches this filter.
            </p>
        }
    }
    else
    {
        @* The heading and the one action share a line; the filter is its own line below. *@
        <div class="tvdb-page-head">
            <h1 class="mb-0">My Library</h1>
            @if (!Model.IsEmpty)
            {
                <a asp-page="/Search" class="btn btn-primary">
                    <i class="@Icons.Search me-1" aria-hidden="true"></i>Find series or movies
                </a>
            }
        </div>

        @if (showFilters)
        {
            <div class="tvdb-filter-row">
                <partial name="_TypeFilterBar" model="showFilters" />
            </div>
        }

        @if (Model.IsEmpty)
        {
            <partial name="_EmptyState" model="@(new EmptyStateModel
                     {
                         Icon = Icons.EmptyLibrary,
                         Heading = "Your library is empty",
                         Text = "Save a series or add a movie to your watchlist and it shows up here, sorted by what you still have to watch.",
                         ActionText = "Find series or movies",
                         ActionPage = "/Search"
                     })" />
        }
        else
        {
            @* The dormant group is not a section of its own here: it is drawn inside Watching. *@
            @foreach (var part in Model.Sections.Where(s => s.Section != LibrarySection.Dormant))
            {
                var hasDormant = part.Section == LibrarySection.Watching && Model.Dormant.Count > 0;
                if (part.Items.Count == 0 && !hasDormant)
                {
                    continue;
                }

                // Watching is what the page is for: always the full grid. On a
                // phone the other three are one scrolling row each, with a link
                // to the section on its own; from 576px they are grids too.
                var isRow = part.Section != LibrarySection.Watching;

                <section class="tvdb-page-section" id="@part.Slug" data-library-section>
                    <div class="tvdb-section-head">
                        <h2 class="mb-0">@part.Title <span class="tvdb-count">@part.Items.Count</span></h2>
                        @if (isRow)
                        {
                            <a asp-page="/Library" asp-route-section="@part.Slug" class="tvdb-section-head__link d-sm-none"
                               aria-label="See all @part.Items.Count in @part.Title">See all @part.Items.Count <i class="@Icons.Forward" aria-hidden="true"></i></a>
                        }
                    </div>

                    @if (part.Items.Count > 0)
                    {
                        <div class="tvdb-series-grid @(isRow ? "tvdb-series-grid--row-on-phone" : null)">
                            @foreach (var item in part.Items)
                            {
                                <partial name="_SeriesCard" model="@ToCardModel(item, likeFields)" />
                            }
                        </div>
                    }
                    else
                    {
                        <p class="tvdb-meta mb-0">Nothing you have watched recently is waiting.</p>
                    }

                    @if (hasDormant)
                    {
                        // Series in progress but not touched in a while: collapsed
                        // from 576px, a scrolling row with "See all" on a phone.
                        var dormant = Model.Sections.Single(s => s.Section == LibrarySection.Dormant);

                        <div class="tvdb-subgroup" id="@dormant.Slug">
                            <div class="tvdb-section-head">
                                <h3 class="mb-0">@dormant.Title <span class="tvdb-count">@dormant.Items.Count</span></h3>
                                <a asp-page="/Library" asp-route-section="@dormant.Slug" class="tvdb-section-head__link d-sm-none"
                                   aria-label="See all @dormant.Items.Count you haven't watched in a while">See all @dormant.Items.Count <i class="@Icons.Forward" aria-hidden="true"></i></a>
                                <button type="button" class="btn btn-outline-dark btn-sm d-none d-sm-inline-flex align-items-center tvdb-subgroup__toggle"
                                        data-bs-toggle="collapse" data-bs-target="#dormantSeries"
                                        aria-expanded="false" aria-controls="dormantSeries">
                                    <span data-toggle-label data-more="Show @dormant.Items.Count" data-less="Hide">Show @dormant.Items.Count</span>
                                    <i class="@Icons.Expand ms-1" aria-hidden="true"></i>
                                </button>
                            </div>
                            <div class="collapse tvdb-subgroup__body" id="dormantSeries">
                                <div class="tvdb-series-grid tvdb-series-grid--row-on-phone">
                                    @foreach (var item in dormant.Items)
                                    {
                                        <partial name="_SeriesCard" model="@ToCardModel(item, likeFields)" />
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </section>
            }

            <p id="tvdb-library-empty-filter" class="tvdb-meta" role="status" hidden>
                Nothing matches this filter.
            </p>
        }
    }
</div>

@section Scripts {
    <script src="~/js/tvdb-type-filter.js" asp-append-version="true"></script>
    <script>
        // The "haven't watched in a while" group: its button says what pressing it does.
        (function () {
            var body = document.getElementById('dormantSeries');
            var label = document.querySelector('.tvdb-subgroup__toggle [data-toggle-label]');
            if (!body || !label) return;

            body.addEventListener('show.bs.collapse', function () { label.textContent = label.dataset.less; });
            body.addEventListener('hide.bs.collapse', function () { label.textContent = label.dataset.more; });
        })();
    </script>
}
