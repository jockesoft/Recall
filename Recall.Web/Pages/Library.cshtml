@page
@using Recall.Web.Domain.TheTvDb
@using Recall.Web.Pages.Shared
@model Recall.Web.Pages.LibraryModel
@{
    ViewData["Title"] = "My Library";

    var allItems = Model.Watching.Concat(Model.ToWatch).Concat(Model.UpToDate).Concat(Model.Watched);
    var hasSeries = allItems.Any(i => i.Type == SearchResultType.Series);
    var hasMovies = allItems.Any(i => i.Type == SearchResultType.Movie);
    var showFilters = hasSeries && hasMovies;
}

@functions {
    static SeriesCardModel ToCardModel(LibraryCardItem item) => new()
    {
        TvdbId = item.TvdbId,
        Name = item.Name,
        ImageUrl = item.ImageUrl,
        FirstAired = item.FirstAired,
        WatchedEpisodes = item.WatchedEpisodes,
        ReleasedEpisodes = item.ReleasedEpisodes,
        Caption = item.Caption,
        DetailsPage = item.Type == SearchResultType.Movie ? "/Movies/Details" : "/Series/Details",
        BadgeIcon = item.Type == SearchResultType.Movie ? Icons.Movie : Icons.Series,
        BadgeLabel = item.Type == SearchResultType.Movie ? "Movie" : "Series",
        BadgeVariant = item.Type == SearchResultType.Movie ? "movie" : "series",
        ShowLike = item.Type == SearchResultType.Series,
        IsLiked = item.IsLiked
    };
}

<div class="tvdb-shell">
    <h1 class="mb-3">My Library</h1>

    @if (!Model.IsEmpty)
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
            <a asp-page="/Search" class="btn btn-primary">Find series or movies</a>

            <partial name="_TypeFilterBar" model="showFilters" />
        </div>
    }

    @if (Model.IsEmpty)
    {
        <partial name="_EmptyState" model="@(new EmptyStateModel
                 {
                     Icon = Icons.EmptyLibrary,
                     Heading = "Your library is empty",
                     Text = "Save a series or add a movie to your watchlist and it shows up here, sorted by what you still have to watch.",
                     ActionText = "Find series or movies",
                     ActionPage = "/Search"
                 })" />
    }
    else
    {
        @if (Model.Watching.Count > 0)
        {
            <div class="tvdb-library-section" data-library-section>
                <h2 class="tvdb-section-title">Watching <span class="tvdb-count">@Model.Watching.Count</span></h2>
                <div class="tvdb-series-grid mb-4">
                    @foreach (var item in Model.Watching)
                    {
                        <partial name="_SeriesCard" model="@ToCardModel(item)" />
                    }
                </div>
            </div>
        }

        @if (Model.ToWatch.Count > 0)
        {
            <div class="tvdb-library-section" data-library-section>
                <h2 class="tvdb-section-title">To Watch <span class="tvdb-count">@Model.ToWatch.Count</span></h2>
                <div class="tvdb-series-grid mb-4">
                    @foreach (var item in Model.ToWatch)
                    {
                        <partial name="_SeriesCard" model="@ToCardModel(item)" />
                    }
                </div>
            </div>
        }

        @if (Model.UpToDate.Count > 0)
        {
            <div class="tvdb-library-section" data-library-section>
                <h2 class="tvdb-section-title">Up to Date <span class="tvdb-count">@Model.UpToDate.Count</span></h2>
                <div class="tvdb-series-grid mb-4">
                    @foreach (var item in Model.UpToDate)
                    {
                        <partial name="_SeriesCard" model="@ToCardModel(item)" />
                    }
                </div>
            </div>
        }

        @if (Model.Watched.Count > 0)
        {
            <div class="tvdb-library-section" data-library-section>
                <h2 class="tvdb-section-title">Watched <span class="tvdb-count">@Model.Watched.Count</span></h2>
                <div class="tvdb-series-grid mb-4">
                    @foreach (var item in Model.Watched)
                    {
                        <partial name="_SeriesCard" model="@ToCardModel(item)" />
                    }
                </div>
            </div>
        }

        <p id="tvdb-library-empty-filter" class="tvdb-meta" role="status" hidden>
            Nothing matches this filter.
        </p>
    }
</div>

@section Scripts {
    <script src="~/js/tvdb-type-filter.js" asp-append-version="true"></script>
}
