# ============================================
# BUILD STAGE
# ============================================
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

# Copy everything
COPY . .
# Copy the build.txt file to the image
# COPY build.txt /app/build.txt

# Restore + publish (Release)
RUN dotnet restore
WORKDIR /src/Recall.Web
RUN dotnet publish Recall.Web.csproj -c Release -o /app/publish --no-restore

# Copy build.txt to the publish directory
COPY build.txt /app/publish/build.txt

# ============================================
# RUNTIME STAGE (small, secure)
# ============================================
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final

# Install time zone data + fonts (same as dev)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        tzdata \
        fonts-dejavu \
        fonts-liberation \
        fontconfig \
        procps && \
    rm -rf /var/lib/apt/lists/*

# No LANG/LC_ALL: the app is English-only and pins its own culture at startup
# (AppCulture.PinToEnglish), so the container's locale must not decide how
# dates and numbers render.
ENV TZ=UTC

# Log folder
RUN mkdir -p /var/log/recallapp && chmod -R 777 /var/log/recallapp

WORKDIR /app

# Copy published output from build stage
COPY --from=build /app/publish .

# Switch to non-root user
USER app

# Expose production port (match your ASPNETCORE_URLS)
EXPOSE 8701

# Run the app
ENTRYPOINT ["dotnet", "Recall.Web.dll"]
