# Recall's production image, built on Docker Hardened Images (dhi.io). Pulling
# from dhi.io needs a Docker Hub login (CI: the DHI_USERNAME and DHI_TOKEN
# secrets). The tags float on the major version, so every CI build picks up
# DHI's patches.

# ============================================
# BUILD STAGE
# ============================================
FROM dhi.io/dotnet:10-sdk AS build
WORKDIR /src

# Restore from the project file alone, so this layer is reused while it is unchanged.
COPY Recall.Web/Recall.Web.csproj Recall.Web/
RUN dotnet restore Recall.Web/Recall.Web.csproj

COPY . .
RUN dotnet publish Recall.Web/Recall.Web.csproj -c Release -o /app/publish --no-restore /p:UseAppHost=false

# Written by CI (the run number); shown in the footer.
COPY build.txt /app/publish/build.txt

# The runtime image has no shell, so the folders the app writes to are made
# here and copied in with their owner: the log folder and the Data Protection
# key folder ($HOME/.aspnet/DataProtection-Keys of the nonroot user). Both are
# bind-mounted in production (compose.prod.yml), from folders owned by 65532.
RUN mkdir -p /out/logs /out/dataprotection-keys

# ============================================
# RUNTIME STAGE: no shell, no package manager, no RUN steps
# ============================================
FROM dhi.io/aspnetcore:10 AS final

# Logs and anything else that prints a local time say UTC. Time zone data and
# ICU come with the image (the release-moment rule needs the zones).
ENV TZ=UTC

COPY --from=build --chown=65532:65532 /out/logs /var/log/recallapp
COPY --from=build --chown=65532:65532 /out/dataprotection-keys /home/nonroot/.aspnet/DataProtection-Keys

# Keep exactly /app: Data Protection scopes its keys to the content root, so a
# different folder would make every existing cookie and unsubscribe link unreadable.
WORKDIR /app
COPY --from=build /app/publish .

# The image's nonroot user.
USER 65532:65532

EXPOSE 8701

# The app checks itself (no curl here): dotnet Recall.Web.dll healthcheck asks
# /health/live on the port from ASPNETCORE_URLS or ASPNETCORE_HTTP_PORTS.
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD ["dotnet", "/app/Recall.Web.dll", "healthcheck"]

ENTRYPOINT ["dotnet", "Recall.Web.dll"]
